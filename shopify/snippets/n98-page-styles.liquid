{%- comment -%}
  N°98 Maps: shared look for the content pages (Sizes & frames, Our story).
  Same tokens as the homepage section.
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Hanken+Grotesk:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400&display=swap">
<style>
.n98h {
  --paper: #F4F1EB; --card: #FBFAF7; --wall: #E6E0D5; --ink: #141414; --ink-2: #47433C; --mute: #5E594F;
  --line: #DDD6CA; --line-strong: #B9B0A1; --accent: #1E3529; --pin: #D94848;
  --serif: 'Cormorant Garamond', 'Times New Roman', Georgia, serif;
  --sans: 'Hanken Grotesk', system-ui, -apple-system, sans-serif;
  --mono: 'IBM Plex Mono', ui-monospace, monospace;
  --ease: cubic-bezier(.22, .61, .36, 1);
  background: var(--paper); color: var(--ink); font-family: var(--sans); font-size: 16px; font-weight: 400; line-height: 1.6;
  -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
}
.n98h *, .n98h *::before, .n98h *::after { box-sizing: border-box; }
.n98h h1, .n98h h2, .n98h h3, .n98h p, .n98h ul, .n98h figure { margin: 0; padding: 0; }
.n98h h1, .n98h h2, .n98h h3 { font-family: var(--serif); font-weight: 300; letter-spacing: -0.01em; color: var(--ink); text-transform: none; }
.n98h em { font-style: italic; font-weight: 400; }
.n98h a { color: inherit; text-decoration: none; }
.n98h img { display: block; max-width: 100%; height: auto; }
.n98h :focus-visible { outline: 1px solid var(--ink); outline-offset: 3px; }
.n98h .n98-wrap { max-width: 1320px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); }
.n98h .n98-eyebrow { font-family: var(--mono); font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--mute); }
.n98h .n98-btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 14px; min-height: 56px; padding: 0 30px;
  font-family: var(--sans); font-size: 11px; font-weight: 500; letter-spacing: 0.26em; text-transform: uppercase;
  border: 1px solid var(--ink); transition: background 0.35s var(--ease), color 0.35s var(--ease);
}
.n98h .n98-btn svg { transition: transform 0.35s var(--ease); }
.n98h .n98-btn:hover svg { transform: translateX(4px); }
.n98h .n98-btn-solid { background: var(--accent); border-color: var(--accent); color: #F4F1EB; }
.n98h .n98-btn-solid:hover { background: #152A1F; }
.n98h .n98-btn-line { background: transparent; color: var(--ink); }
.n98h .n98-btn-line:hover { background: var(--ink); color: var(--paper); }
.n98h .n98-link-line { font-size: 11px; font-weight: 500; letter-spacing: 0.24em; text-transform: uppercase; border-bottom: 1px solid var(--ink); padding-bottom: 5px; }
.n98h section { position: relative; }

.n98h .n98p-hero { padding: clamp(56px, 9vw, 120px) 0 clamp(40px, 6vw, 72px); border-bottom: 1px solid var(--line); }
.n98h .n98p-hero h1 { font-size: clamp(46px, 7vw, 96px); line-height: 0.98; margin-top: 18px; max-width: 12em; }
.n98h .n98p-hero p.n98p-lede { margin-top: 24px; max-width: 34em; font-size: clamp(17px, 1.6vw, 19px); font-weight: 300; color: var(--ink-2); }
.n98h .n98p-sec { padding: clamp(56px, 8vw, 104px) 0; border-bottom: 1px solid var(--line); }
.n98h .n98p-sec:last-of-type { border-bottom: 0; }
.n98h .n98p-sec h2 { font-size: clamp(34px, 4.4vw, 58px); line-height: 1.02; margin: 14px 0 clamp(28px, 4vw, 48px); max-width: 14em; }
.n98h .n98p-cta { padding: clamp(56px, 8vw, 104px) 0; text-align: center; background: var(--accent); color: #F4F1EB; }
.n98h .n98p-cta h2 { color: #F4F1EB; font-size: clamp(36px, 5vw, 64px); line-height: 1.02; margin: 14px auto 32px; max-width: 13em; }
.n98h .n98p-cta .n98-eyebrow { color: #C9A96E; }
.n98h .n98p-cta .n98-btn { border-color: #F4F1EB; color: #F4F1EB; }
.n98h .n98p-cta .n98-btn:hover { background: #F4F1EB; color: var(--accent); }
</style>
