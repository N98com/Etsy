{%- comment -%}
  N°98 Maps: small secondary links in the menu drawer (mono caps).
  Edit them in Shopify admin: Content, Menus, "N°98 Maps small links".
{%- endcomment -%}
{%- case request.locale.iso_code -%}
{%- when 'nl' -%}
{%- assign n98_small = linklists['n98-maps-small-links'] -%}
<nav class="n98-small-links" aria-label="Meer">
  {%- if n98_small.links.size > 0 -%}
    {%- for link in n98_small.links -%}
      <a href="{{ link.url }}"{% if link.url contains 'instagram.com' %} target="_blank" rel="noopener"{% endif %}>{{ link.title }}</a>
    {%- endfor -%}
  {%- else -%}
    <a href="/nl/#how-it-works">Zo werkt het</a>
    <a href="/nl/#faq">Vragen</a>
    <a href="/nl/#faq">Verzending &amp; retour</a>
    <a href="/nl/pages/contact">Contact</a>
    <a href="https://www.instagram.com/n98.maps/" target="_blank" rel="noopener">Instagram</a>
  {%- endif -%}
</nav>
{%- else -%}
{%- assign n98_small = linklists['n98-maps-small-links'] -%}
<nav class="n98-small-links" aria-label="More">
  {%- if n98_small.links.size > 0 -%}
    {%- for link in n98_small.links -%}
      <a href="{{ link.url }}"{% if link.url contains 'instagram.com' %} target="_blank" rel="noopener"{% endif %}>{{ link.title }}</a>
    {%- endfor -%}
  {%- else -%}
    <a href="/#how-it-works">How it works</a>
    <a href="/#faq">FAQ</a>
    <a href="/#faq">Shipping &amp; returns</a>
    <a href="/pages/contact">Contact</a>
    <a href="https://www.instagram.com/n98.maps/" target="_blank" rel="noopener">Instagram</a>
  {%- endif -%}
</nav>
{%- endcase -%}
