{%- comment -%}
  N°98 Maps: luxury styling for the mobile menu drawer and the localization
  (currency) selector. Rendered in layout/theme.liquid <head>.
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Mono:wght@400&display=swap">
<style>
  /* Drawer: narrower panel, cream paper, quiet backdrop */
  .menu-drawer {
    width: min(84vw, 340px) !important;
    max-width: 340px !important;
    background-color: #F4F1EB !important;
    border-right: 1px solid #DDD6CA !important;
    box-shadow: 30px 0 60px -30px rgba(20, 20, 20, 0.35);
  }
  .menu-drawer__backdrop { backdrop-filter: none !important; background: rgba(20, 20, 20, 0.32); }

  /* Eyebrow above the links */
  .menu-drawer__navigation::before {
    content: 'N°98 Maps';
    display: block;
    padding: 6px var(--drawer-padding, 24px) 18px;
    font-family: 'IBM Plex Mono', ui-monospace, Menlo, monospace;
    font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: #47433C;
  }

  /* Main links: serif, calm size, hairline dividers */
  .menu-drawer__menu.has-submenu > li {
    border-bottom: 1px solid #DDD6CA;
  }
  .menu-drawer__menu.has-submenu > li:first-child { border-top: 1px solid #DDD6CA; }
  .menu-drawer__menu-item--mainlist {
    padding-block: 16px !important;
    min-height: 0 !important;
  }
  .menu-drawer__menu-item--mainlist .menu-drawer__menu-item-text {
    font-family: 'Cormorant Garamond', Georgia, serif !important;
    font-weight: 400 !important;
    font-size: 27px !important;
    line-height: 1.1 !important;
    letter-spacing: 0.005em !important;
    text-transform: none !important;
    color: #141414 !important;
  }
  .menu-drawer__menu-item--mainlist:hover .menu-drawer__menu-item-text { font-style: italic; }
  .menu-drawer__close-button { color: #141414; }

  /* Bottom: our own currency switch (EUR / USD / GBP) */
  .n98-currency { margin: auto var(--drawer-padding, 24px) 18px; padding-top: 18px; border-top: 1px solid #DDD6CA; }
  .n98-currency__label {
    display: block; margin-bottom: 10px;
    font-family: 'IBM Plex Mono', ui-monospace, Menlo, monospace;
    font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: #47433C;
  }
  .n98-currency__options { display: flex; gap: 8px; }
  .n98-currency__btn {
    flex: 1 1 0; min-height: 44px; border: 1px solid #DDD6CA; background: transparent; color: #141414; cursor: pointer;
    font-family: 'IBM Plex Mono', ui-monospace, Menlo, monospace; font-size: 12px; letter-spacing: 0.12em;
  }
  .n98-currency__btn[aria-pressed="true"] { background: #141414; border-color: #141414; color: #F4F1EB; }

  /* Header (mobile): search stays left next to the menu. Horizon moves it to the
     right when there is no <shopify-account>; our account link replaced that. */
  @media screen and (max-width: 749px) {
    #header-component .header__columns .search-action { grid-area: leftB !important; }
  }
  #header-component[data-menu-style='drawer'] .header__columns .search-action { grid-area: leftB !important; }

  /* Currency switch in the desktop header (hidden on mobile, where it lives in the menu) */
  .n98-currency-desktop { display: none; align-items: center; margin-inline-end: 6px; }
  @media screen and (min-width: 750px) {
    #header-component:not([data-menu-style='drawer']) .n98-currency-desktop { display: flex; }
  }
  /* Desktop: small currency dropdown */
  .n98-curdrop { position: relative; }
  .n98-curdrop > summary { list-style: none; }
  .n98-curdrop > summary::-webkit-details-marker { display: none; }
  .n98-curdrop__toggle {
    display: flex; align-items: center; gap: 7px; min-height: 44px; padding: 0 8px; cursor: pointer;
    font-family: 'IBM Plex Mono', ui-monospace, Menlo, monospace; font-size: 10.5px; letter-spacing: 0.12em; color: #141414;
  }
  .n98-curdrop__caret { transition: transform .2s ease; color: #47433C; }
  .n98-curdrop[open] .n98-curdrop__caret { transform: rotate(180deg); }
  .n98-curdrop__menu {
    position: absolute; top: calc(100% - 2px); right: 0; z-index: 30; min-width: 108px;
    display: flex; flex-direction: column; padding: 6px 0;
    background: #F4F1EB; border: 1px solid #DDD6CA; box-shadow: 0 14px 30px -18px rgba(20, 20, 20, 0.35);
  }
  .n98-curdrop__opt {
    display: block; width: 100%; padding: 10px 16px; border: 0; background: transparent; text-align: left; cursor: pointer;
    font-family: 'IBM Plex Mono', ui-monospace, Menlo, monospace; font-size: 10.5px; letter-spacing: 0.12em; color: #47433C;
  }
  .n98-curdrop__opt:hover { color: #141414; background: rgba(20, 20, 20, 0.04); }
  .n98-curdrop__opt[aria-pressed="true"] { color: #141414; text-decoration: underline; text-underline-offset: 5px; }
  .menu-drawer__utility-links .n98-currency { margin: 0 var(--drawer-padding, 24px) 18px 0; }
</style>

