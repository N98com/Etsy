{%- comment -%}
  N°98 Maps: currency switch (EUR / USD / GBP).
  variant: 'drawer' (bottom of the mobile menu) or 'inline' (desktop header).
{%- endcomment -%}
{%- liquid
  assign n98_cur = localization.country.currency.iso_code
  assign n98_eur_country = 'NL'
  if n98_cur == 'EUR'
    assign n98_eur_country = localization.country.iso_code
  endif
-%}
<div class="n98-currency n98-currency--{{ variant | default: 'drawer' }}">
  {%- if variant != 'inline' -%}<span class="n98-currency__label">Currency</span>{%- endif -%}
  <div class="n98-currency__options" role="group" aria-label="Currency">
    <button type="button" class="n98-currency__btn" data-n98-country="{{ n98_eur_country }}" aria-pressed="{% if n98_cur == 'EUR' %}true{% else %}false{% endif %}">€ EUR</button>
    <button type="button" class="n98-currency__btn" data-n98-country="US" aria-pressed="{% if n98_cur == 'USD' %}true{% else %}false{% endif %}">$ USD</button>
    <button type="button" class="n98-currency__btn" data-n98-country="GB" aria-pressed="{% if n98_cur == 'GBP' %}true{% else %}false{% endif %}">£ GBP</button>
  </div>
</div>
