{%- comment -%}
  N°98 Maps: language switch (English, Nederlands, later Deutsch and Français).
  Shows every language that is published in Shopify, so a new language appears
  here by itself. variant: 'drawer' (bottom of the mobile menu) or 'inline'
  (desktop header). Uses the hidden form of n98-currency-form.
{%- endcomment -%}
{%- if localization.available_languages.size > 1 -%}
  {%- assign n98_lang = localization.language.iso_code -%}
  {%- if variant == 'inline' -%}
    <details class="n98-curdrop n98-langdrop">
      <summary class="n98-curdrop__toggle" aria-label="{{ 'n98.header.language' | t }}: {{ localization.language.endonym_name | escape }}">
        <span>{{ n98_lang | upcase }}</span>
        <svg class="n98-curdrop__caret" width="9" height="6" viewBox="0 0 9 6" aria-hidden="true"><path d="M1 1l3.5 3.5L8 1" fill="none" stroke="currentColor" stroke-width="1.1"/></svg>
      </summary>
      <div class="n98-curdrop__menu" role="group" aria-label="{{ 'n98.header.language' | t }}">
        {%- for l in localization.available_languages -%}
          <button type="button" class="n98-curdrop__opt" data-n98-lang="{{ l.iso_code }}" lang="{{ l.iso_code }}" aria-pressed="{% if l.iso_code == n98_lang %}true{% else %}false{% endif %}">{{ l.endonym_name | capitalize | escape }}</button>
        {%- endfor -%}
      </div>
    </details>
  {%- else -%}
    <div class="n98-currency n98-currency--lang n98-currency--{{ variant | default: 'drawer' }}">
      <span class="n98-currency__label">{{ 'n98.header.language' | t }}</span>
      <div class="n98-currency__options" role="group" aria-label="{{ 'n98.header.language' | t }}">
        {%- for l in localization.available_languages -%}
          <button type="button" class="n98-currency__btn" data-n98-lang="{{ l.iso_code }}" lang="{{ l.iso_code }}" aria-pressed="{% if l.iso_code == n98_lang %}true{% else %}false{% endif %}">{{ l.iso_code | upcase }}</button>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
{%- endif -%}
