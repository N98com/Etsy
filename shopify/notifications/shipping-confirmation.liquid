{%- comment -%}
  N°98 Maps: shipping confirmation email (Settings → Notifications → Shipping confirmation).
  Cream paper, ink, Cormorant style serif with Georgia fallback, mono labels.
{%- endcomment -%}
{%- if fulfillment.item_count == item_count -%}
  {%- assign ship_title = 'is on its way' -%}{%- assign ship_eyebrow = 'Shipped' -%}
{%- elsif fulfillment_status == 'fulfilled' -%}
  {%- assign ship_title = 'the last part of your order is on its way' -%}{%- assign ship_eyebrow = 'Final shipment' -%}
{%- else -%}
  {%- assign ship_title = 'part of your order is on its way' -%}{%- assign ship_eyebrow = 'Partly shipped' -%}
{%- endif -%}
{%- capture email_title -%}Your order is on the way{%- endcapture -%}
{%- assign first_name = customer.first_name | default: shipping_address.first_name -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light only">
  <meta name="supported-color-schemes" content="light only">
  <title>{{ email_title }}</title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    body { margin: 0; padding: 0; background: #E6E0D5; -webkit-text-size-adjust: 100%; }
    table { border-collapse: collapse; }
    img { border: 0; display: block; }
    a { color: #141414; }
    .serif { font-family: 'Cormorant Garamond', Garamond, Georgia, 'Times New Roman', serif; }
    .mono { font-family: 'IBM Plex Mono', 'SFMono-Regular', Menlo, Consolas, 'Courier New', monospace; }
    .sans { font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif; }
    @media (max-width: 620px) {
      .wrap { width: 100% !important; }
      .pad { padding-left: 24px !important; padding-right: 24px !important; }
      .h1 { font-size: 34px !important; }
      .col { display: block !important; width: 100% !important; padding: 0 0 18px !important; }
    }
  </style>
</head>
<body style="margin:0;padding:0;background:#E6E0D5;">
  <div style="display:none;max-height:0;overflow:hidden;">Your map has left the studio and is on its way to you.</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#E6E0D5;">
    <tr><td align="center" style="padding:32px 12px;">
      <table role="presentation" class="wrap" width="600" cellpadding="0" cellspacing="0" style="width:600px;background:#F4F1EB;">

        <!-- Header -->
        <tr><td class="pad" style="padding:36px 48px 22px;border-bottom:1px solid #141414;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
            <td valign="middle">
              {%- if shop.email_logo_url -%}
                <a href="{{ shop.url }}" style="text-decoration:none;"><img src="{{ shop.email_logo_url }}" alt="{{ shop.name }}" width="{{ shop.email_logo_width | default: 150 }}" style="height:auto;"></a>
              {%- else -%}
                <a href="{{ shop.url }}" style="text-decoration:none;color:#141414;"><span class="serif" style="font-size:30px;font-weight:500;color:#141414;">N°98</span><span style="display:inline-block;width:1px;height:22px;background:#141414;margin:0 12px;vertical-align:-3px;"></span><span class="mono" style="font-size:11px;letter-spacing:5px;color:#141414;">MAPS</span></a>
              {%- endif -%}
            </td>
            <td valign="middle" align="right" class="mono" style="font-size:10px;letter-spacing:3px;color:#5E594F;text-transform:uppercase;">Order {{ order_name }}</td>
          </tr></table>
        </td></tr>

        <!-- Intro -->
        <tr><td class="pad" style="padding:38px 48px 8px;">
          <p class="mono" style="margin:0 0 14px;font-size:10px;letter-spacing:3px;text-transform:uppercase;color:#5E594F;">{{ ship_eyebrow }}</p>
          <h1 class="serif h1" style="margin:0;font-size:40px;line-height:1.08;font-weight:400;color:#141414;">
            {%- if fulfillment.item_count == item_count -%}
              {%- if first_name != blank -%}{{ first_name }}, your map<br>{%- else -%}Your map<br>{%- endif -%}<em style="font-style:italic;">is on its way.</em>
            {%- else -%}
              {%- if first_name != blank -%}{{ first_name }},<br>{%- endif -%}<em style="font-style:italic;">{{ ship_title | capitalize }}.</em>
            {%- endif -%}
          </h1>
          <p class="sans" style="margin:20px 0 0;font-size:15px;line-height:1.65;color:#47433C;">Your print has left the studio, carefully packed for its journey. Use the tracking details below to follow it all the way to your door.</p>
        </td></tr>

        <!-- Tracking -->
        <tr><td class="pad" style="padding:22px 48px 6px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #DDD6CA;background:#FBFAF7;"><tr>
            <td style="padding:18px 20px;">
              {%- if fulfillment.estimated_delivery_at -%}
                <p class="mono" style="margin:0 0 4px;font-size:9.5px;letter-spacing:3px;text-transform:uppercase;color:#5E594F;">Expected</p>
                <p class="serif" style="margin:0 0 14px;font-size:24px;line-height:1.2;color:#141414;">{{ fulfillment.estimated_delivery_at | date: format: 'date' }}</p>
              {%- endif -%}
              <p class="mono" style="margin:0 0 6px;font-size:9.5px;letter-spacing:3px;text-transform:uppercase;color:#5E594F;">Tracking</p>
              {%- if fulfillment.tracking_numbers.size > 0 -%}
                {%- for tracking_number in fulfillment.tracking_numbers -%}
                  <p class="sans" style="margin:0 0 4px;font-size:14px;line-height:1.5;color:#141414;">
                    {%- if fulfillment.tracking_company -%}{{ fulfillment.tracking_company }}: {% endif -%}
                    {%- if fulfillment.tracking_urls[forloop.index0] -%}<a href="{{ fulfillment.tracking_urls[forloop.index0] }}" style="color:#141414;">{{ tracking_number }}</a>{%- else -%}{{ tracking_number }}{%- endif -%}
                  </p>
                {%- endfor -%}
              {%- else -%}
                <p class="sans" style="margin:0;font-size:14px;line-height:1.5;color:#141414;">Your tracking details will appear on your order page as soon as the carrier has scanned your parcel.</p>
              {%- endif -%}
            </td>
          </tr></table>
        </td></tr>

        <tr><td class="pad" style="padding:26px 48px 4px;">
          <table role="presentation" cellpadding="0" cellspacing="0"><tr>
            {%- if fulfillment.tracking_numbers.size == 1 and fulfillment.tracking_url -%}
            <td style="background:#1E3529;"><a href="{{ fulfillment.tracking_url }}" class="sans" style="display:inline-block;padding:15px 26px;font-size:11px;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:#F4F1EB;text-decoration:none;">Track your map &nbsp;&rarr;</a></td>
            {%- if order_status_url -%}<td style="padding-left:16px;" class="sans"><a href="{{ order_status_url }}" style="font-size:13px;color:#141414;">View your order</a></td>{%- endif -%}
            {%- elsif order_status_url -%}
            <td style="background:#1E3529;"><a href="{{ order_status_url }}" class="sans" style="display:inline-block;padding:15px 26px;font-size:11px;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:#F4F1EB;text-decoration:none;">View your order &nbsp;&rarr;</a></td>
            {%- endif -%}
          </tr></table>
        </td></tr>

        <!-- Items -->
        <tr><td class="pad" style="padding:38px 48px 0;">
          <p class="mono" style="margin:0 0 10px;font-size:10px;letter-spacing:3px;text-transform:uppercase;color:#5E594F;">In this parcel</p>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-top:1px solid #141414;">
            {%- for line in fulfillment.fulfillment_line_items -%}
            {%- assign li = line.line_item -%}
            <tr>
              <td valign="top" width="76" style="padding:18px 16px 18px 0;border-bottom:1px solid #DDD6CA;">
                {%- if li.image -%}<img src="{{ li | img_url: 'compact_cropped' }}" width="60" height="60" alt="" style="width:60px;height:60px;border:1px solid #DDD6CA;">{%- endif -%}
              </td>
              <td valign="top" style="padding:18px 0;border-bottom:1px solid #DDD6CA;">
                <p class="serif" style="margin:0;font-size:21px;line-height:1.2;color:#141414;">{{ li.product.title | default: li.title }}{% if li.quantity > 1 %} <span class="mono" style="font-size:12px;color:#5E594F;">{% if line.quantity < li.quantity %}{{ line.quantity }} of {{ li.quantity }}{% else %}&times; {{ li.quantity }}{% endif %}</span>{% endif %}</p>
                {%- if li.variant.title != blank and li.variant.title != 'Default Title' -%}
                  <p class="mono" style="margin:5px 0 0;font-size:11px;letter-spacing:1px;color:#5E594F;">{{ li.variant.title }}</p>
                {%- endif -%}
                {%- for property in li.properties -%}
                  {%- assign p_first = property.first | slice: 0 -%}
                  {%- if property.last != blank and p_first != '_' and property.first != 'Size' and property.first != 'Frame' and property.first != 'Coordinates' and property.last != 'None' -%}
                    <p class="sans" style="margin:4px 0 0;font-size:13px;line-height:1.45;color:#47433C;"><span style="color:#8A8378;">{{ property.first }}:</span> {{ property.last }}</p>
                  {%- endif -%}
                {%- endfor -%}
              </td>
            </tr>
            {%- endfor -%}
          </table>
        </td></tr>

        <!-- Care -->
        <tr><td class="pad" style="padding:40px 48px 0;">
          <p class="mono" style="margin:0 0 8px;font-size:9.5px;letter-spacing:3px;text-transform:uppercase;color:#5E594F;">When it arrives</p>
          <p class="sans" style="margin:0;font-size:14px;line-height:1.6;color:#47433C;">Open the parcel with care and let an unframed print rest flat for a day before framing. Keep your map out of direct sunlight so the colours stay deep for years. Arrived damaged? Send us a photo within 14 days and we will make it right.</p>
        </td></tr>

        <!-- Personal note -->
        <tr><td class="pad" style="padding:34px 48px 0;">
          <p class="serif" style="margin:0;font-size:20px;line-height:1.45;font-style:italic;color:#141414;">We hope it finds the perfect wall. Share it with us on Instagram, we love seeing where our maps end up.</p>
        </td></tr>

        <!-- Footer -->
        <tr><td class="pad" style="padding:40px 48px 36px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-top:1px solid #141414;"><tr>
            <td align="center" style="padding-top:22px;">
              <p class="mono" style="margin:0 0 10px;font-size:9.5px;letter-spacing:3px;text-transform:uppercase;color:#141414;">Printed to order &middot; Free shipping worldwide</p>
              <p class="sans" style="margin:0;font-size:13px;line-height:1.7;color:#5E594F;">
                Questions? Reply to this email or write to <a href="mailto:{{ shop.email }}" style="color:#141414;">{{ shop.email }}</a><br>
                <a href="https://wa.me/31613168888" style="color:#141414;">WhatsApp</a> &nbsp;&middot;&nbsp; <a href="https://www.instagram.com/n98.maps/" style="color:#141414;">Instagram</a> &nbsp;&middot;&nbsp; <a href="{{ shop.url }}" style="color:#141414;">n98maps.com</a>
              </p>
            </td>
          </tr></table>
        </td></tr>

      </table>
    </td></tr>
  </table>
</body>
</html>
