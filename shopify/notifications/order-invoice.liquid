{%- comment -%}
  N°98 Maps: order invoice email (Settings → Notifications → Order invoice).
  Sent from an order with an outstanding balance. Cream paper, ink, serif, mono labels.
{%- endcomment -%}
{%- capture email_title -%}Payment for order {{ order_name }}{%- endcapture -%}
{%- if payment_terms.type == 'fulfillment' and payment_terms.next_payment.due_at == nil -%}{%- assign due_on_fulfillment = true -%}{%- else -%}{%- assign due_on_fulfillment = false -%}{%- endif -%}
{%- if source_name == 'shopify_draft_order' and financial_status == 'pending' -%}{%- assign order_from_draft = true -%}{%- else -%}{%- assign order_from_draft = false -%}{%- endif -%}
{%- if payment_terms.type == 'receipt' and payment_terms.next_payment.due_at == nil -%}{%- assign due_date = 'now' -%}{%- else -%}{%- assign due_date = payment_terms.next_payment.due_at | default: nil -%}{%- endif -%}
{%- assign outstanding = order.total_outstanding | default: total_price -%}
{%- assign total_order_discount_amount = 0 -%}
{%- for discount_application in discount_applications -%}
  {%- if discount_application.target_selection == 'all' and discount_application.target_type == 'line_item' -%}
    {%- assign total_order_discount_amount = total_order_discount_amount | plus: discount_application.total_allocated_amount -%}
  {%- endif -%}
{%- endfor -%}
{%- assign first_name = customer.first_name | default: billing_address.first_name | default: shipping_address.first_name -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light only">
  <meta name="supported-color-schemes" content="light only">
  <title>{{ email_title }}</title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    body { margin: 0; padding: 0; background: #E6E0D5; -webkit-text-size-adjust: 100%; }
    table { border-collapse: collapse; }
    img { border: 0; display: block; }
    a { color: #141414; }
    .serif { font-family: 'Cormorant Garamond', Garamond, Georgia, 'Times New Roman', serif; }
    .mono { font-family: 'IBM Plex Mono', 'SFMono-Regular', Menlo, Consolas, 'Courier New', monospace; }
    .sans { font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif; }
    @media (max-width: 620px) {
      .wrap { width: 100% !important; }
      .pad { padding-left: 24px !important; padding-right: 24px !important; }
      .h1 { font-size: 34px !important; }
      .col { display: block !important; width: 100% !important; padding: 0 0 18px !important; }
    }
  </style>
</head>
<body style="margin:0;padding:0;background:#E6E0D5;">
  <div style="display:none;max-height:0;overflow:hidden;">A payment for order {{ order_name }} is waiting for you.</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#E6E0D5;">
    <tr><td align="center" style="padding:32px 12px;">
      <table role="presentation" class="wrap" width="600" cellpadding="0" cellspacing="0" style="width:600px;background:#F4F1EB;">

        <!-- Header -->
        <tr><td class="pad" style="padding:36px 48px 22px;border-bottom:1px solid #141414;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
            <td valign="middle">
              {%- if shop.email_logo_url -%}
                <a href="{{ shop.url }}" style="text-decoration:none;"><img src="{{ shop.email_logo_url }}" alt="{{ shop.name }}" width="{{ shop.email_logo_width | default: 150 }}" style="height:auto;"></a>
              {%- else -%}
                <a href="{{ shop.url }}" style="text-decoration:none;color:#141414;"><span class="serif" style="font-size:30px;font-weight:500;color:#141414;">N°98</span><span style="display:inline-block;width:1px;height:22px;background:#141414;margin:0 12px;vertical-align:-3px;"></span><span class="mono" style="font-size:11px;letter-spacing:5px;color:#141414;">MAPS</span></a>
              {%- endif -%}
            </td>
            <td valign="middle" align="right" class="mono" style="font-size:10px;letter-spacing:3px;color:#5E594F;text-transform:uppercase;">Invoice {{ order_name }}</td>
          </tr></table>
        </td></tr>

        <!-- Intro -->
        <tr><td class="pad" style="padding:38px 48px 8px;">
          <p class="mono" style="margin:0 0 14px;font-size:10px;letter-spacing:3px;text-transform:uppercase;color:#5E594F;">Payment due</p>
          <h1 class="serif h1" style="margin:0;font-size:40px;line-height:1.08;font-weight:400;color:#141414;">
            {%- if first_name != blank -%}{{ first_name }}, one last step<br>{%- else -%}One last step<br>{%- endif -%}<em style="font-style:italic;">and we start drawing.</em>
          </h1>
          <p class="sans" style="margin:20px 0 0;font-size:15px;line-height:1.65;color:#47433C;">
            {%- if due_on_fulfillment == true and payment_terms.automatic_capture_at_fulfillment == false or payment_terms.automatic_capture_at_fulfillment == true and order_from_draft == true -%}
              A payment of <strong style="color:#141414;">{{ outstanding | money }}</strong> for order {{ order_name }} is due when your map ships.
            {%- elsif due_date == 'now' or due_date == nil -%}
              A payment of <strong style="color:#141414;">{{ outstanding | money }}</strong> for order {{ order_name }} is waiting for you. As soon as it is complete, your map goes to print.
            {%- else -%}
              A payment of <strong style="color:#141414;">{{ outstanding | money }}</strong> for order {{ order_name }} is due on {{ due_date | date: format: 'date' }}.
            {%- endif -%}
          </p>
          {%- if custom_message != blank -%}
            <p class="sans" style="margin:14px 0 0;font-size:15px;line-height:1.65;color:#47433C;">{{ custom_message }}</p>
          {%- endif -%}
        </td></tr>

        {%- if checkout_payment_collection_url -%}
        <tr><td class="pad" style="padding:26px 48px 4px;">
          <table role="presentation" cellpadding="0" cellspacing="0"><tr>
            <td style="background:#1E3529;"><a href="{{ checkout_payment_collection_url }}" class="sans" style="display:inline-block;padding:15px 26px;font-size:11px;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:#F4F1EB;text-decoration:none;">Pay now &nbsp;&rarr;</a></td>
          </tr></table>
        </td></tr>
        {%- endif -%}

        <!-- Items -->
        <tr><td class="pad" style="padding:38px 48px 0;">
          <p class="mono" style="margin:0 0 10px;font-size:10px;letter-spacing:3px;text-transform:uppercase;color:#5E594F;">Order summary</p>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-top:1px solid #141414;">
            {%- for line in subtotal_line_items -%}
            <tr>
              <td valign="top" width="76" style="padding:18px 16px 18px 0;border-bottom:1px solid #DDD6CA;">
                {%- if line.image -%}<img src="{{ line | img_url: 'compact_cropped' }}" width="60" height="60" alt="" style="width:60px;height:60px;border:1px solid #DDD6CA;">{%- endif -%}
              </td>
              <td valign="top" style="padding:18px 0;border-bottom:1px solid #DDD6CA;">
                <p class="serif" style="margin:0;font-size:21px;line-height:1.2;color:#141414;">{{ line.product.title | default: line.title }}{% if line.quantity > 1 %} <span class="mono" style="font-size:12px;color:#5E594F;">&times; {{ line.quantity }}</span>{% endif %}</p>
                {%- if line.variant.title != blank and line.variant.title != 'Default Title' -%}
                  <p class="mono" style="margin:5px 0 0;font-size:11px;letter-spacing:1px;color:#5E594F;">{{ line.variant.title }}</p>
                {%- endif -%}
                {%- for property in line.properties -%}
                  {%- assign p_first = property.first | slice: 0 -%}
                  {%- if property.last != blank and p_first != '_' and property.first != 'Size' and property.first != 'Frame' and property.first != 'Coordinates' and property.last != 'None' -%}
                    <p class="sans" style="margin:4px 0 0;font-size:13px;line-height:1.45;color:#47433C;"><span style="color:#8A8378;">{{ property.first }}:</span> {{ property.last }}</p>
                  {%- endif -%}
                {%- endfor -%}
                {%- for discount_allocation in line.discount_allocations -%}
                  {%- if discount_allocation.discount_application.target_selection != 'all' -%}
                    <p class="mono" style="margin:6px 0 0;font-size:11px;color:#1E3529;">{{ discount_allocation.discount_application.title | upcase }} (&minus;{{ discount_allocation.amount | money }})</p>
                  {%- endif -%}
                {%- endfor -%}
              </td>
              <td valign="top" align="right" class="mono" style="padding:20px 0 18px 12px;border-bottom:1px solid #DDD6CA;font-size:13px;color:#141414;white-space:nowrap;">
                {%- if line.original_line_price != line.final_line_price -%}<del style="color:#8A8378;">{{ line.original_line_price | money }}</del><br>{%- endif -%}
                {%- if line.final_line_price > 0 -%}{{ line.final_line_price | money }}{%- else -%}Free{%- endif -%}
              </td>
            </tr>
            {%- endfor -%}
          </table>
        </td></tr>

        <!-- Totals -->
        <tr><td class="pad" style="padding:16px 48px 0;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="sans" style="font-size:14px;color:#47433C;">
            <tr><td style="padding:5px 0;">Subtotal</td><td align="right" class="mono" style="padding:5px 0;font-size:13px;color:#141414;">{{ subtotal_price | plus: total_order_discount_amount | money }}</td></tr>
            {%- if total_order_discount_amount > 0 -%}
            <tr><td style="padding:5px 0;">Discount</td><td align="right" class="mono" style="padding:5px 0;font-size:13px;color:#1E3529;">&minus;{{ total_order_discount_amount | money }}</td></tr>
            {%- endif -%}
            {%- if requires_shipping -%}
            <tr><td style="padding:5px 0;">Shipping</td><td align="right" class="mono" style="padding:5px 0;font-size:13px;color:#141414;">{% if shipping_price == 0 %}Free{% else %}{{ shipping_price | money }}{% endif %}</td></tr>
            {%- endif -%}
            {%- if total_duties -%}
            <tr><td style="padding:5px 0;">Duties</td><td align="right" class="mono" style="padding:5px 0;font-size:13px;color:#141414;">{{ total_duties | money }}</td></tr>
            {%- endif -%}
            {%- if tax_price > 0 -%}
            <tr><td style="padding:5px 0;">VAT {% if taxes_included %}<span style="color:#8A8378;">(included)</span>{% endif %}</td><td align="right" class="mono" style="padding:5px 0;font-size:13px;color:#141414;">{{ tax_price | money }}</td></tr>
            {%- endif -%}
            <tr>
              <td class="serif" style="padding:14px 0 4px;border-top:1px solid #141414;font-size:22px;color:#141414;">Total</td>
              <td align="right" class="mono" style="padding:14px 0 4px;border-top:1px solid #141414;font-size:15px;font-weight:500;color:#141414;">{{ total_price | money_with_currency }}</td>
            </tr>
            {%- if outstanding < total_price -%}
            <tr><td style="padding:8px 0 0;">Already paid</td><td align="right" class="mono" style="padding:8px 0 0;font-size:13px;color:#141414;">{{ total_price | minus: outstanding | money }}</td></tr>
            {%- endif -%}
            <tr><td style="padding:8px 0 0;color:#141414;"><strong>Amount due</strong></td><td align="right" class="mono" style="padding:8px 0 0;font-size:14px;font-weight:500;color:#1E3529;">{{ outstanding | money_with_currency }}</td></tr>
          </table>
        </td></tr>

        <!-- Addresses -->
        <tr><td class="pad" style="padding:40px 48px 0;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-top:1px solid #DDD6CA;"><tr>
            {%- if requires_shipping and shipping_address -%}
            <td class="col" valign="top" width="50%" style="padding:20px 16px 0 0;">
              <p class="mono" style="margin:0 0 8px;font-size:9.5px;letter-spacing:3px;text-transform:uppercase;color:#5E594F;">Shipping to</p>
              <div class="sans" style="font-size:14px;line-height:1.55;color:#141414;">{{ shipping_address | format_address }}</div>
            </td>
            {%- endif -%}
            {%- if billing_address -%}
            <td class="col" valign="top" width="50%" style="padding:20px 0 0;">
              <p class="mono" style="margin:0 0 8px;font-size:9.5px;letter-spacing:3px;text-transform:uppercase;color:#5E594F;">Billing address</p>
              <div class="sans" style="font-size:14px;line-height:1.55;color:#141414;">{{ billing_address | format_address }}</div>
            </td>
            {%- endif -%}
          </tr></table>
        </td></tr>

        <!-- Personal note -->
        <tr><td class="pad" style="padding:40px 48px 0;">
          <p class="serif" style="margin:0;font-size:20px;line-height:1.45;font-style:italic;color:#141414;">Every map we make is about one place and the story behind it. We cannot wait to draw yours.</p>
        </td></tr>

        <!-- Footer -->
        <tr><td class="pad" style="padding:40px 48px 36px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-top:1px solid #141414;"><tr>
            <td align="center" style="padding-top:22px;">
              <p class="mono" style="margin:0 0 10px;font-size:9.5px;letter-spacing:3px;text-transform:uppercase;color:#141414;">Printed to order &middot; Free shipping worldwide</p>
              <p class="sans" style="margin:0;font-size:13px;line-height:1.7;color:#5E594F;">
                Questions? Reply to this email or write to <a href="mailto:{{ shop.email }}" style="color:#141414;">{{ shop.email }}</a><br>
                <a href="https://wa.me/31613168888" style="color:#141414;">WhatsApp</a> &nbsp;&middot;&nbsp; <a href="https://www.instagram.com/n98.maps/" style="color:#141414;">Instagram</a> &nbsp;&middot;&nbsp; <a href="{{ shop.url }}" style="color:#141414;">n98maps.com</a>
              </p>
            </td>
          </tr></table>
        </td></tr>

      </table>
    </td></tr>
  </table>
</body>
</html>
