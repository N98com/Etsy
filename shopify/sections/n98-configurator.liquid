<script>
  (function () {
    var frame = document.getElementById('n98c-frame-{{ section.id }}');
    // Homepage handoff: /products/...#design=... (een kaart uit de galerij) of
    // #occasion=... (een cadeau-sjabloon) opent de designer daarmee
    if (/^#(design=[A-Za-z0-9_-]+|occasion=[a-z-]+)$/.test(window.location.hash)) {
      frame.src = frame.src.split('#')[0] + window.location.hash;
      try { history.replaceState(null, '', window.location.pathname + window.location.search); } catch (e) {}
    }
    var APP_ORIGIN = new URL(frame.src).origin;
    var CART_URL = {{ routes.cart_url | json }};
    var CART_ADD_URL = {{ routes.cart_add_url | append: '.js' | json }};
    var VARIANTS = {
      {%- for v in product.variants -%}
        {%- if v.sku != blank -%}{{ v.sku | json }}: { id: {{ v.id }}, available: {{ v.available | json }} }{%- unless forloop.last -%},{%- endunless -%}{%- endif -%}
      {%- endfor -%}
    };
    var FALLBACK_VARIANT = {{ product.selected_or_first_available_variant.id | json }};

    // Desktop: the frame fills the screen below the theme header.
    function fit() {
      var top = frame.getBoundingClientRect().top + window.scrollY;
      frame.style.height = Math.max(640, window.innerHeight - Math.max(0, top)) + 'px';
    }

    // Mobile: the frame fills the whole screen and the theme header (menu,
    // logo, cart) lies over its top edge. While the customer scrolls inside
    // the designer, the frame reports how far, and the header slides up by
    // exactly that many pixels, in step with the map shrinking below it.
    var headerGroup = document.getElementById('header-group');
    var hostTop = 0, overlay = false;
    function headerParts() { return headerGroup ? Array.prototype.slice.call(headerGroup.children) : []; }
    function sendHost() {
      if (frame.contentWindow) frame.contentWindow.postMessage({ source: 'n98-shop', type: 'host', top: hostTop }, APP_ORIGIN);
    }
    function layout() {
      var parts = headerParts();
      overlay = !!headerGroup && window.innerWidth < 900;
      frame.style.marginTop = '';
      if (overlay) {
        hostTop = Math.max(0, Math.round(frame.getBoundingClientRect().top + window.scrollY));
        parts.forEach(function (el) { el.style.position = 'relative'; el.style.zIndex = '30'; el.style.willChange = 'transform'; });
        frame.style.marginTop = (-hostTop) + 'px';
        frame.style.minHeight = '0';
        frame.style.height = window.innerHeight + 'px';
      } else {
        hostTop = 0;
        parts.forEach(function (el) { el.style.position = ''; el.style.zIndex = ''; el.style.willChange = ''; el.style.transform = ''; });
        frame.style.minHeight = '';
        fit();
      }
      sendHost();
    }
    function setHeaderY(y) {
      if (!overlay) return;
      y = Math.max(0, Math.min(hostTop, +y || 0));
      var t = y ? 'translate3d(0,' + (-y) + 'px,0)' : '';
      headerParts().forEach(function (el) { el.style.transform = t; });
    }
    var lastW = 0, lastH = 0;
    function onResize() {
      // ignore the small height changes of a phone's address bar
      if (window.innerWidth === lastW && Math.abs(window.innerHeight - lastH) < 140 && overlay) { frame.style.height = window.innerHeight + 'px'; return; }
      lastW = window.innerWidth; lastH = window.innerHeight;
      layout();
    }
    onResize();
    window.addEventListener('resize', onResize);
    window.addEventListener('load', function () { lastW = 0; onResize(); });
    frame.addEventListener('load', sendHost);

    function reply(type, message, itemCount) {
      frame.contentWindow.postMessage({ source: 'n98-shop', type: type, message: message, itemCount: itemCount }, APP_ORIGIN);
    }

    // Vanuit de ontwerper: "View cart & checkout"
    window.addEventListener('message', function (e) {
      if (e.origin !== APP_ORIGIN || e.source !== frame.contentWindow) return;
      if (e.data && e.data.source === 'n98-shop-frame' && e.data.type === 'go-cart') window.location.href = CART_URL;
      if (e.data && e.data.source === 'n98-shop-frame' && e.data.type === 'host-scroll') setHeaderY(e.data.y);
      if (e.data && e.data.source === 'n98-shop-frame' && e.data.type === 'hello') sendHost();
    });

    // Link naar de werkbank met het ontwerp erin: één tik in de bestelling
    // opent MapGen2.0 met exact dit ontwerp, klaar voor de print-export.
    var WORKBENCH_URL = {{ section.settings.workbench_url | default: 'https://n98com.github.io/Etsy/index.html' | json }};
    function printLink(state) {
      var bytes = new TextEncoder().encode(JSON.stringify(state));
      var bin = '';
      for (var i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
      return WORKBENCH_URL + '#order=' + btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    }

    function joinParts(parts) {
      return parts.filter(function (p) { return p && String(p).trim(); }).join(', ');
    }

    window.addEventListener('message', function (e) {
      if (e.origin !== APP_ORIGIN || e.source !== frame.contentWindow) return;
      var msg = e.data;
      if (!msg || msg.source !== 'mapgen2' || msg.type !== 'confirm' || !msg.payload) return;
      var d = msg.payload.design || {};
      var size = d.size || {};
      var frameChoice = d.frame && d.frame !== 'none' ? d.frame : '';
      var variant = VARIANTS[frameChoice ? size.id + '-' + frameChoice : size.id];
      if (!variant || !variant.available) {
        reply('error', 'This size or frame is not available right now. Please pick another one.');
        return;
      }
      var loc = d.location || {};
      var st = d.state || {};
      var text = st.text || {};
      var pins = d.pins || [];
      var props = {
        'Location': joinParts([loc.place, loc.region, loc.country]) || 'Custom location',
        'Coordinates': (typeof loc.lat === 'number' ? loc.lat.toFixed(5) + ', ' + loc.lon.toFixed(5) : ''),
        'Size': size.label || size.id,
        'Frame': frameChoice ? (d.frameLabel || frameChoice) + ' (ready to hang)' : 'No frame',
        'Palette': (d.palette && d.palette.name) || '',
        'Title': text.place || '',
        'Subtitle': joinParts([text.region, text.country]),
        'Pins': pins.length ? pins.map(function (p) { return p.icon === 'letters' ? 'letters “' + (p.text || '') + '”' : (p.icon || 'pin'); }).join(', ') : 'None',
        '_Print file': printLink(st),
        '_Design JSON': JSON.stringify(st)
      };
      Object.keys(props).forEach(function (k) { if (props[k] === '') delete props[k]; });

      fetch(CART_ADD_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: [{ id: variant.id || FALLBACK_VARIANT, quantity: 1, properties: props }] })
      })
        .then(function (r) {
          return r.json().then(function (j) {
            if (!r.ok) throw new Error(j && (j.description || j.message) || 'Could not add to cart');
            return j;
          });
        })
        .then(function () { return fetch({{ routes.cart_url | append: '.js' | json }}, { headers: { 'Accept': 'application/json' } }); })
        .then(function (r) { return r.json(); })
        .then(function (cart) {
          var count = (cart && cart.item_count) || 1;
          // het winkelmandje-icoon in de header bijwerken (Horizon cart-icon)
          document.querySelectorAll('cart-icon').forEach(function (el) {
            try { if (typeof el.renderCartBubble === 'function') el.renderCartBubble(count); } catch (e) {}
          });
          reply('added', null, count);
        })
        .catch(function (err) {
          reply('error', (err && err.message) || 'Could not add to cart. Please try again.');
        });
    });
  })();
</script>
