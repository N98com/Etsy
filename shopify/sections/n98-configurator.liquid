  .n98c-steps b, .n98c-faq dt { color: #141414; font-weight: 600; }
  .n98c-sizes { list-style: none; margin: 0 0 12px; padding: 0; border-top: 1px solid #DDD6C9; }
  .n98c-sizes li { display: flex; justify-content: space-between; gap: 12px; padding: 9px 0; border-bottom: 1px solid #DDD6C9; font-size: 15px; }
  .n98c-sizes li span:last-child { color: #141414; text-align: right; }
  .n98c-small { font-size: 13px !important; color: #6B665C !important; margin: 0; }
