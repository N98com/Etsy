  .n98c-about { background: #F4F1EB; color: #141414; border-top: 1px solid #DDD6C9; }
  .n98c-about__wrap { max-width: 1080px; margin: 0 auto; padding: clamp(56px, 8vw, 104px) 22px clamp(64px, 8vw, 112px); }
  .n98c-eyebrow { margin: 0 0 14px; font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 10.5px; letter-spacing: 0.24em; text-transform: uppercase; color: #6B665C; }
  .n98c-about h2 { margin: 0 0 18px; font-family: 'Cormorant Garamond', Cormorant, Georgia, serif; font-weight: 400; font-size: clamp(34px, 4.6vw, 54px); line-height: 1.04; }
  .n98c-about h2 em { font-style: italic; }
  .n98c-about h3 { margin: 0 0 12px; font-family: 'Hanken Grotesk', system-ui, sans-serif; font-size: 11px; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; }
  .n98c-about p, .n98c-about li, .n98c-about dd { font-family: 'Hanken Grotesk', system-ui, sans-serif; font-size: 16px; line-height: 1.65; color: #4A463F; }
  .n98c-lede { max-width: 40em; margin: 0 0 clamp(36px, 5vw, 56px); font-size: 18px !important; }
  .n98c-cols { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 72px); margin-bottom: clamp(32px, 5vw, 56px); }
  .n98c-cols p { margin: 0; }
  .n98c-steps { margin: 0; padding-left: 1.2em; }
