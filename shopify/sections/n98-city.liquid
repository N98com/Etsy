{%- comment -%}
  N°98 Maps: page per city (template page.city), and the overview of all cities
  when the page has no city (the hub /pages/city-map-prints).
  The map of a city is in the page metafield n98.city (json: name, country, lat,
  lon, palette, scale, img). The list of all cities, grouped by country, is the
  shop metafield n98.cities (json: [{s: slug, n: name, c: group, i: image,
  nl/de/fr: local name}]). Texts come from the locale files (n98.city.*).
{%- endcomment -%}
{%- liquid
  assign city = page.metafields.n98.city.value
  assign lede = page.metafields.n98.lede.value
  assign cities = shop.metafields.n98.cities.value
  assign lang = request.locale.iso_code
  # prints with the words in the language of the visitor (tools/home-renders/variants.py)
  assign img_sfx = '.jpg'
  if lang == 'nl' or lang == 'de' or lang == 'fr'
    assign img_sfx = '--' | append: lang | append: '.jpg'
  endif
  assign pfx = routes.root_url
  if pfx == '/'
    assign pfx = ''
  endif
  assign designer = all_products['design-your-map']
  assign designer_url = pfx | append: '/products/design-your-map'
  assign hub_url = pfx | append: '/pages/city-map-prints'
  # own country first
  assign groups = 'nl,be,de,fr,uk,no,se,eu,us' | split: ','
  if lang == 'de'
    assign groups = 'de,nl,be,fr,uk,no,se,eu,us' | split: ','
  elsif lang == 'fr'
    assign groups = 'fr,be,nl,de,uk,no,se,eu,us' | split: ','
  endif
  assign slug = page.handle | remove: '-map-print'
  assign group = ''
  if city
    assign name = city.name
    for e in cities
      if e.s == slug
        assign group = e.c
        assign name = e[lang] | default: e.n
      endif
    endfor
    assign country_key = city.country | handleize | replace: '-', '_' | prepend: 'n98.country.'
    assign country = country_key | t
    if country contains 'ranslation missing'
      assign country = city.country
    endif
    capture design_json
      echo '{"v":1,"center":{"lat":'
      echo city.lat
      echo ',"lon":'
      echo city.lon
      echo '},"scale":'
      echo city.scale
      echo ',"ratioId":"in20x28","palette":"'
      echo city.palette
      echo '","layout":"fade","mask":"none","matColor":"#f7f4ee","textColor":null,"font":"default","show":{"place":true,"region":false,"country":true,"coords":true},"text":{"place":"'
      echo name
      echo '","region":"","country":"'
      echo country
      echo '"},"textScale":{"place":1,"region":1,"country":1,"coords":1},"pins":[],"pinColor":"#e63946","pinScale":1,"printBorder":false,"style":null}'
    endcapture
    assign design_hash = design_json | strip | base64_url_safe_encode | remove: '='
    assign design_link = designer_url | append: '#design=' | append: design_hash
    assign img = 'n98-' | append: city.img | append: img_sfx
  endif
  assign from_price = designer.price_min | default: 3900 | money_without_trailing_zeros
  assign arrow = '<svg width="22" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M0 5h20M16 1l4 4-4 4"/></svg>'
-%}

<div class="n98o">
  {%- if city -%}
    <section class="n98o-hero">
      <div class="n98o-wrap n98o-hero__grid">
        <div class="n98o-hero__text">
          <p class="n98o-eyebrow">{{ 'n98.city.eyebrow' | t }} · {{ country | escape }}</p>
          <h1>{{ page.title | escape }}</h1>
          {%- if lede != blank -%}<p class="n98o-lede">{{ lede | escape }}</p>{%- endif -%}
          <a class="n98o-cta" href="{{ design_link }}">{{ 'n98.city.design_your' | t: city: name | escape }} {{ arrow }}</a>
          <ul class="n98o-trust">
            <li>{{ 'n98.city.from' | t: price: from_price }}</li>
            <li>{{ 'n98.city.free_shipping' | t }}</li>
            <li>{{ 'n98.city.framed' | t }}</li>
          </ul>
        </div>
        <div class="n98o-hero__art">
          <img src="{{ img | asset_url }}" alt="{{ 'n98.city.img_alt' | t: city: name | escape }}" width="1200" height="1680" fetchpriority="high">
        </div>
      </div>
    </section>

    <section class="n98o-body">
      <div class="n98o-wrap n98o-rte">
        {{ page.content }}
        <h3>{{ 'n98.city.made_title' | t }}</h3>
        <p>{{ 'n98.city.made_body' | t }}</p>
        <p class="n98o-cta-row"><a class="n98o-cta" href="{{ design_link }}">{{ 'n98.city.start_with' | t: city: name | escape }} {{ arrow }}</a></p>
        <p class="n98o-small">{{ 'n98.city.not_your_city_html' | t: url: designer_url }}</p>
      </div>
    </section>
  {%- else -%}
    <section class="n98o-hero n98o-hero--hub">
      <div class="n98o-wrap">
        <p class="n98o-eyebrow">{{ 'n98.city.eyebrow' | t }}</p>
        <h1>{{ page.title | escape }}</h1>
        {%- if lede != blank -%}<p class="n98o-lede">{{ lede | escape }}</p>{%- endif -%}
        {%- if page.content != blank -%}<div class="n98o-rte">{{ page.content }}</div>{%- endif -%}
        <p class="n98o-small n98o-jump">{%- for g in groups -%}<a href="#{{ g }}">{{ 'n98.city.group_' | append: g | t }}</a>{% unless forloop.last %} · {% endunless %}{%- endfor -%}</p>
      </div>
    </section>
  {%- endif -%}

  <section class="n98o-more">
    <div class="n98o-wrap">
      {%- for g in groups -%}
        {%- if city and g != group -%}{%- continue -%}{%- endif -%}
        <div class="n98o-group" id="{{ g }}">
          <p class="n98o-eyebrow">{% if city %}{{ 'n98.city.more_' | append: g | t }}{% else %}{{ 'n98.city.group_' | append: g | t }}{% endif %}</p>
          <div class="n98o-more__grid">
            {%- for e in cities -%}
              {%- if e.c != g or e.s == slug -%}{%- continue -%}{%- endif -%}
              {%- assign en = e[lang] | default: e.n -%}
              <a class="n98o-tile" href="{{ pfx }}/pages/{{ e.s }}-map-print">
                <img src="{{ 'n98-' | append: e.i | append: img_sfx | asset_url }}" alt="{{ 'n98.city.img_alt' | t: city: en | escape }}" loading="lazy" width="1200" height="1680">
                <span class="n98o-tile__line">{{ en }}</span>
              </a>
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
      {%- if city -%}
        <p class="n98o-small n98o-more__note">{{ 'n98.city.other_countries' | t }}
          {% for g in groups %}{% if g != group %}<a href="{{ hub_url }}#{{ g }}">{{ 'n98.city.group_' | append: g | t }}</a> · {% endif %}{% endfor %}<a href="{{ hub_url }}">{{ 'n98.city.all_cities' | t }}</a></p>
      {%- endif -%}
      <p class="n98o-small n98o-more__note">{{ 'n98.city.not_here_html' | t: url: designer_url }}</p>
    </div>
  </section>
</div>

<style>
  .n98o { background: #F4F1EB; color: #141414; }
  .n98o-wrap { max-width: 1180px; margin: 0 auto; padding: 0 22px; }
  .n98o-eyebrow { margin: 0 0 16px; font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 10.5px; letter-spacing: 0.24em; text-transform: uppercase; color: #6B665C; }
  .n98o-hero { padding: clamp(40px, 7vw, 96px) 0 clamp(48px, 7vw, 96px); }
  .n98o-hero--hub .n98o-lede { max-width: 38em; }
  .n98o-hero__grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(32px, 6vw, 88px); align-items: center; }
  .n98o h1 { margin: 0 0 20px; font-family: 'Cormorant Garamond', Cormorant, Georgia, serif; font-weight: 400; font-size: clamp(40px, 5.4vw, 68px); line-height: 1.02; letter-spacing: -0.005em; }
  .n98o-lede { margin: 0 0 30px; max-width: 32em; font-family: 'Hanken Grotesk', system-ui, sans-serif; font-size: 18px; line-height: 1.6; color: #4A463F; }
  .n98o-cta { display: inline-flex; align-items: center; gap: 14px; min-height: 56px; padding: 0 28px; background: #1E3529; color: #F4F1EB; text-decoration: none; font-family: 'Hanken Grotesk', system-ui, sans-serif; font-size: 12px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; transition: background 0.25s ease; }
  .n98o-cta:hover { background: #142019; }
  /* the button sits inside the body text, so it must not take the dark link colour of .n98o-rte a */
  .n98o .n98o-cta, .n98o .n98o-cta:visited, .n98o .n98o-cta:hover, .n98o .n98o-cta:focus-visible { color: #F4F1EB; text-decoration: none; }
  .n98o .n98o-cta:focus-visible { outline: 2px solid #1E3529; outline-offset: 3px; }
  .n98o-cta svg { transition: transform 0.3s ease; }
  .n98o-cta:hover svg { transform: translateX(4px); }
  .n98o-trust { list-style: none; margin: 26px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 22px; font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: #6B665C; }
  .n98o-hero__art { background: #E6E0D5; padding: 9%; }
  .n98o-hero__art img { display: block; width: 100%; height: auto; box-shadow: 0 1px 1px rgba(30,24,16,.1), 0 30px 48px -22px rgba(30,24,16,.55); }
  .n98o-body { padding: clamp(56px, 8vw, 104px) 0; border-top: 1px solid #DDD6C9; }
  .n98o-rte { max-width: 760px; font-family: 'Hanken Grotesk', system-ui, sans-serif; font-size: 17px; line-height: 1.7; color: #4A463F; }
  .n98o-rte h2 { margin: 48px 0 14px; font-family: 'Cormorant Garamond', Cormorant, Georgia, serif; font-weight: 400; font-size: clamp(30px, 3.6vw, 42px); line-height: 1.08; color: #141414; }
  .n98o-rte h2:first-child { margin-top: 0; }
  .n98o-rte h3 { margin: 28px 0 8px; font-size: 12px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: #141414; }
  .n98o-rte p { margin: 0 0 16px; }
  .n98o-rte ul { margin: 0 0 16px; padding-left: 1.2em; }
  .n98o-rte li { margin-bottom: 6px; }
  .n98o-rte em { font-family: 'Cormorant Garamond', Cormorant, Georgia, serif; font-size: 1.2em; color: #141414; }
  .n98o-rte a, .n98o-small a { color: #141414; text-underline-offset: 3px; }
  .n98o-cta-row { margin-top: 40px !important; }
  .n98o-small { font-family: 'Hanken Grotesk', system-ui, sans-serif; font-size: 14px; color: #6B665C; }
  .n98o-more { padding: clamp(56px, 8vw, 96px) 0 clamp(64px, 8vw, 112px); background: #ECE7DE; }
  .n98o-more__grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: clamp(18px, 2.4vw, 32px) clamp(14px, 2vw, 28px); }
  .n98o-more__note { margin: clamp(28px, 4vw, 44px) 0 0; line-height: 1.9; }
  .n98o-more__note + .n98o-more__note { margin-top: 12px; }
  .n98o-group + .n98o-group { margin-top: clamp(56px, 7vw, 88px); }
  .n98o-group { scroll-margin-top: 90px; }
  .n98o-jump { margin-top: 26px; line-height: 2; }
  .n98o-jump a { color: #141414; text-underline-offset: 3px; }
  .n98o-tile { display: flex; flex-direction: column; gap: 6px; color: #141414; text-decoration: none; }
  .n98o-tile img { display: block; width: 100%; height: auto; margin-bottom: 8px; box-shadow: 0 18px 30px -18px rgba(30,24,16,.5); transition: transform 0.5s ease; }
  .n98o-tile:hover img { transform: translateY(-4px); }
  .n98o-tile__line { font-family: 'Cormorant Garamond', Cormorant, Georgia, serif; font-style: italic; font-size: 21px; line-height: 1.15; }
  @media (max-width: 899px) {
    .n98o-hero__grid { grid-template-columns: 1fr; }
    .n98o-hero__art { order: -1; padding: 10% 16%; }
    .n98o-more__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 16px; }
    .n98o-cta { width: 100%; justify-content: center; }
  }
</style>

{% schema %}
{
  "name": "N°98 city page",
  "tag": "div",
  "settings": []
}
{% endschema %}
