{%- comment -%}
  N°98 Maps — landingspagina. GEGENEREERD uit home.html door
  tools/build-shopify-home.py; pas home.html aan en draai het script opnieuw.
{%- endcomment -%}
{%- liquid
  assign n98_handle = section.settings.configurator_handle | default: 'custom-map-poster-your-location-physical-print'
  assign n98_configurator_url = routes.root_url | append: '/products/' | append: n98_handle | replace: '//', '/'
-%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Hanken+Grotesk:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400&display=swap">
<div class="n98h">
<style>
.n98h {
  --paper: #F4F1EB; --card: #FBFAF7; --wall: #E6E0D5; --ink: #141414; --ink-2: #47433C; --mute: #5E594F;
  --line: #DDD6CA; --line-strong: #B9B0A1; --accent: #1E3529; --pin: #D94848;
  --serif: 'Cormorant Garamond', 'Times New Roman', Georgia, serif;
  --sans: 'Hanken Grotesk', system-ui, -apple-system, sans-serif;
  --mono: 'IBM Plex Mono', ui-monospace, monospace;
  --ease: cubic-bezier(.22, .61, .36, 1);
  background: var(--paper); color: var(--ink); font-family: var(--sans); font-size: 16px; font-weight: 400; line-height: 1.6;
  -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
}
.n98h *, .n98h *::before, .n98h *::after { box-sizing: border-box; }
.n98h h1, .n98h h2, .n98h h3, .n98h p, .n98h ul, .n98h figure { margin: 0; padding: 0; }
.n98h h1, .n98h h2, .n98h h3 { font-family: var(--serif); font-weight: 300; letter-spacing: -0.01em; color: var(--ink); text-transform: none; }
.n98h em { font-style: italic; font-weight: 400; }
.n98h a { color: inherit; text-decoration: none; }
.n98h img { display: block; max-width: 100%; height: auto; }
.n98h :focus-visible { outline: 1px solid var(--ink); outline-offset: 3px; }
.n98h .n98-wrap { max-width: 1320px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); }
.n98h .n98-eyebrow { font-family: var(--mono); font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--mute); }
.n98h .n98-btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 14px; min-height: 56px; padding: 0 30px;
  font-family: var(--sans); font-size: 11px; font-weight: 500; letter-spacing: 0.26em; text-transform: uppercase;
  border: 1px solid var(--ink); transition: background 0.35s var(--ease), color 0.35s var(--ease);
}
.n98h .n98-btn svg { transition: transform 0.35s var(--ease); }
.n98h .n98-btn:hover svg { transform: translateX(4px); }
.n98h .n98-btn-solid { background: var(--accent); border-color: var(--accent); color: #F4F1EB; }
.n98h .n98-btn-solid:hover { background: #152A1F; }
.n98h .n98-btn-line { background: transparent; color: var(--ink); }
.n98h .n98-btn-line:hover { background: var(--ink); color: var(--paper); }
.n98h .n98-link-line { font-size: 11px; font-weight: 500; letter-spacing: 0.24em; text-transform: uppercase; border-bottom: 1px solid var(--ink); padding-bottom: 5px; }
.n98h section { position: relative; }
.n98h .n98-reveal { opacity: 0; transform: translateY(14px); transition: opacity 0.9s var(--ease), transform 0.9s var(--ease); }
.n98h .n98-reveal.n98-in { opacity: 1; transform: none; }

/* aankondiging + header (alleen losse pagina) */
.n98h .n98-note { background: var(--ink); color: #E9E3D8; text-align: center; padding: 9px 12px; font-family: var(--mono); font-size: clamp(8.5px, 2.2vw, 10.5px); letter-spacing: 0.2em; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.n98h .n98-head { border-bottom: 1px solid var(--line); }
.n98h .n98-head .n98-wrap { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 20px; padding-top: 22px; padding-bottom: 22px; }
.n98h .n98-head nav { display: flex; gap: 32px; font-size: 11px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; }
.n98h .n98-logo { display: flex; align-items: center; gap: 13px; }
.n98h .n98-logo img { height: 32px; width: auto; }
.n98h .n98-logo span { font-family: var(--mono); font-size: 11px; letter-spacing: 0.34em; padding: 3px 0 0 13px; border-left: 1px solid var(--line-strong); }
.n98h .n98-head-cta { justify-self: end; }
.n98h .n98-head-cta .n98-btn { min-height: 44px; padding: 0 20px; }
@media (max-width: 860px) {
  .n98h .n98-head nav { display: none; }
  .n98h .n98-head .n98-wrap { grid-template-columns: auto 1fr; padding-top: 14px; padding-bottom: 14px; }
  .n98h .n98-logo img { height: 24px; }
}

/* hero */
.n98h .n98-hero .n98-wrap { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr)); gap: clamp(36px, 6vw, 88px); align-items: center; padding-top: clamp(40px, 7vw, 96px); padding-bottom: clamp(48px, 7vw, 96px); }
.n98h .n98-hero-copy { display: flex; flex-direction: column; gap: 26px; }
.n98h .n98-hero h1 { font-size: clamp(50px, 7vw, 100px); line-height: 0.96; letter-spacing: -0.02em; }
.n98h .n98-hero .n98-lede { font-size: clamp(16px, 1.4vw, 19px); font-weight: 300; color: var(--ink-2); max-width: 44ch; }
.n98h .n98-hero .n98-ctas { display: flex; flex-wrap: wrap; gap: 12px; padding-top: 6px; }
.n98h .n98-hero figure { position: relative; }
.n98h .n98-hero figure img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; }
.n98h .n98-hero figcaption { position: absolute; left: 18px; bottom: 16px; background: rgba(244, 241, 235, 0.92); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); padding: 9px 14px; font-family: var(--mono); font-size: 10px; letter-spacing: 0.2em; }

/* belofte-strook */
.n98h .n98-promise { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.n98h .n98-promise .n98-wrap { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 18px 28px; padding-top: 26px; padding-bottom: 26px; }
.n98h .n98-promise div { display: flex; align-items: center; gap: 14px; font-size: 14px; color: var(--ink-2); }
.n98h .n98-promise svg { flex: 0 0 auto; }

/* stappen */
.n98h .n98-steps .n98-wrap { padding-top: clamp(72px, 10vw, 128px); padding-bottom: clamp(64px, 9vw, 112px); }
.n98h .n98-sec-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: clamp(36px, 5vw, 60px); }
.n98h .n98-sec-head h2 { font-size: clamp(38px, 4.6vw, 62px); line-height: 1.02; max-width: 15em; }
.n98h .n98-sec-head .n98-stack { display: flex; flex-direction: column; gap: 14px; }
.n98h .n98-step-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 40px; }
.n98h .n98-step { border-top: 1px solid var(--ink); padding-top: 22px; display: flex; flex-direction: column; gap: 10px; }
.n98h .n98-step .n98-num { font-family: var(--serif); font-style: italic; font-size: 30px; line-height: 1; }
.n98h .n98-step h3 { font-family: var(--sans); font-size: 11px; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; }
.n98h .n98-step p { color: var(--ink-2); font-weight: 300; }

/* collectie */
.n98h .n98-collection { background: var(--card); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.n98h .n98-collection .n98-wrap { padding-top: clamp(72px, 9vw, 112px); padding-bottom: clamp(72px, 9vw, 112px); }
.n98h .n98-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); gap: 52px 28px; }
@media (max-width: 560px) { .n98h .n98-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px 14px; } }
.n98h .n98-city { display: flex; flex-direction: column; gap: 14px; }
.n98h .n98-city .n98-mat { background: var(--wall); padding: clamp(14px, 2.2vw, 30px); }
.n98h .n98-city img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; background: #fff; padding: 3%; box-shadow: 0 1px 2px rgba(30, 24, 16, 0.12), 0 22px 34px -18px rgba(30, 24, 16, 0.55); transition: transform 0.6s var(--ease), box-shadow 0.6s var(--ease); }
.n98h .n98-city:hover img { transform: translateY(-4px); box-shadow: 0 1px 2px rgba(30, 24, 16, 0.12), 0 32px 44px -20px rgba(30, 24, 16, 0.6); }
.n98h .n98-city .n98-meta { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
.n98h .n98-city .n98-name { font-family: var(--serif); font-size: clamp(20px, 2vw, 25px); line-height: 1.1; }
.n98h .n98-city .n98-pal { display: block; font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em; color: var(--mute); text-transform: uppercase; }
.n98h .n98-city .n98-price { font-size: 13px; color: var(--ink-2); white-space: nowrap; }

/* aan de muur */
.n98h .n98-wall .n98-wrap { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: clamp(36px, 6vw, 88px); align-items: center; padding-top: clamp(72px, 10vw, 128px); padding-bottom: clamp(72px, 10vw, 128px); }
.n98h .n98-wall-copy { display: flex; flex-direction: column; gap: 22px; }
.n98h .n98-wall h2 { font-size: clamp(38px, 4.6vw, 62px); line-height: 1.02; }
.n98h .n98-wall p { color: var(--ink-2); font-weight: 300; max-width: 44ch; }
.n98h .n98-wall ul { list-style: none; display: flex; flex-direction: column; border-top: 1px solid var(--line); }
.n98h .n98-wall li { display: flex; gap: 14px; align-items: baseline; padding: 13px 0; border-bottom: 1px solid var(--line); font-size: 15px; }
.n98h .n98-wall li span { font-family: var(--serif); font-style: italic; font-size: 18px; min-width: 2.2em; }
.n98h .n98-pins { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; color: var(--pin); }
.n98h .n98-pins div { background: var(--card); border: 1px solid var(--line); aspect-ratio: 1 / 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; }
.n98h .n98-pins svg { width: 46%; height: auto; }
.n98h .n98-pins b { font-family: var(--mono); font-weight: 400; font-size: 9.5px; letter-spacing: 0.16em; color: var(--mute); text-transform: uppercase; }

/* cadeau */
.n98h .n98-gift { background: #141513; color: #EDE8DE; }
.n98h .n98-gift .n98-wrap { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: clamp(40px, 7vw, 96px); align-items: center; padding-top: clamp(80px, 10vw, 136px); padding-bottom: clamp(80px, 10vw, 136px); }
.n98h .n98-gift .n98-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; align-items: end; }
.n98h .n98-gift .n98-pair img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; background: #fff; padding: 3%; box-shadow: 0 34px 60px -26px rgba(0, 0, 0, 0.85); }
.n98h .n98-gift .n98-pair img + img { margin-bottom: 64px; }
.n98h .n98-gift-copy { display: flex; flex-direction: column; gap: 24px; }
.n98h .n98-gift h2 { font-size: clamp(40px, 4.8vw, 66px); line-height: 1.02; color: #EDE8DE; }
.n98h .n98-gift p { color: #CFC8BA; font-weight: 300; max-width: 42ch; font-size: 17px; }
.n98h .n98-gift .n98-eyebrow { color: #A9A296; }
.n98h .n98-gift .n98-btn { background: #EDE8DE; border-color: #EDE8DE; color: #141513; align-self: flex-start; }
.n98h .n98-gift .n98-btn:hover { background: #fff; }

/* formaten */
.n98h .n98-sizes .n98-wrap { padding-top: clamp(72px, 10vw, 128px); padding-bottom: clamp(64px, 9vw, 112px); }
.n98h .n98-ladder { display: flex; align-items: flex-end; gap: clamp(14px, 2.6vw, 38px); border-bottom: 1px solid var(--ink); overflow-x: auto; padding-bottom: 0; scrollbar-width: none; }
.n98h .n98-ladder::-webkit-scrollbar { display: none; }
.n98h .n98-rung { flex: 0 0 auto; display: flex; flex-direction: column; align-items: center; gap: 10px; padding-bottom: 18px; }
.n98h .n98-rung i { display: block; border: 1px solid var(--ink); background: var(--card); }
.n98h .n98-rung b { font-family: var(--mono); font-weight: 400; font-size: 11px; }
.n98h .n98-rung small { font-size: 11.5px; color: var(--mute); margin-top: -6px; }

/* faq */
.n98h .n98-faq { border-top: 1px solid var(--line); }
.n98h .n98-faq .n98-wrap { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 48px; padding-top: clamp(72px, 9vw, 112px); padding-bottom: clamp(72px, 9vw, 112px); }
.n98h .n98-faq h2 { font-size: clamp(38px, 4.6vw, 62px); line-height: 1.02; }
.n98h details { border-top: 1px solid var(--line); padding: 22px 0; }
.n98h details:first-of-type { border-top-color: var(--ink); }
.n98h details:last-of-type { border-bottom: 1px solid var(--line); }
.n98h summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: 16px; font-family: var(--serif); font-size: 22px; line-height: 1.25; padding: 0; color: var(--ink); }
.n98h summary:hover { color: var(--ink); }
.n98h summary::-webkit-details-marker { display: none; }
.n98h summary::after { content: '+'; font-weight: 300; font-size: 26px; line-height: 1; transition: transform 0.35s var(--ease); }
.n98h details[open] summary::after { transform: rotate(45deg); }
.n98h details p { margin-top: 12px; color: var(--ink-2); font-weight: 300; max-width: 54ch; }

/* nieuwsbrief + footer */
.n98h .n98-letter { background: var(--accent); color: #EFEAE0; }
.n98h .n98-letter .n98-wrap { padding-top: clamp(72px, 9vw, 104px); padding-bottom: 40px; display: flex; flex-direction: column; gap: 64px; }
.n98h .n98-letter .n98-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 32px; align-items: end; }
.n98h .n98-letter h2 { font-size: clamp(36px, 4vw, 52px); line-height: 1.04; color: #EFEAE0; }
.n98h .n98-letter p { color: #CFD6CF; font-weight: 300; margin-top: 10px; }
.n98h .n98-letter form { display: flex; flex-wrap: wrap; gap: 10px; }
.n98h .n98-letter input[type=email] { flex: 1 1 240px; min-height: 56px; padding: 0 2px; border: 0; border-bottom: 1px solid #8FA394; background: transparent; color: #EFEAE0; font-family: var(--serif); font-size: 21px; border-radius: 0; }
.n98h .n98-letter input::placeholder { color: #9FB0A3; font-style: italic; }
.n98h .n98-letter input:focus { outline: none; border-bottom-color: #EFEAE0; }
.n98h .n98-letter button { min-height: 56px; padding: 0 28px; border: 0; background: #EFEAE0; color: var(--ink); font-family: var(--sans); font-size: 11px; font-weight: 500; letter-spacing: 0.24em; text-transform: uppercase; cursor: pointer; }
.n98h .n98-letter .n98-msg { flex: 1 1 100%; font-size: 13px; color: #CFD6CF; }
.n98h .n98-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 24px; border-top: 1px solid #4F6656; padding-top: 30px; font-size: 13px; color: #CFD6CF; }
.n98h .n98-foot .n98-logo span { border-left-color: #4F6656; color: #CFD6CF; }
.n98h .n98-foot nav { display: flex; flex-wrap: wrap; gap: 26px; }
.n98h .n98-foot nav a { color: #EFEAE0; }

@media (prefers-reduced-motion: reduce) {
  .n98h *, .n98h *::before, .n98h *::after { transition: none !important; animation: none !important; }
  .n98h .n98-reveal { opacity: 1; transform: none; }
}
</style>

<main>
  <section class="n98-hero">
    <div class="n98-wrap">
      <div class="n98-hero-copy">
        <p class="n98-eyebrow">52.3676° N / 4.9041° E</p>
        <h1>The places that made you, <em>drawn to last.</em></h1>
        <p class="n98-lede">Design a map of any city, street or coastline in your own colours and words. Every print is made to order — and made to be framed.</p>
        <div class="n98-ctas">
          <a class="n98-btn n98-btn-solid" href="{{ n98_configurator_url }}">Design your map <svg width="22" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M0 5h20M16 1l4 4-4 4"></path></svg></a>
          <a class="n98-btn n98-btn-line" href="#collection">City editions</a>
        </div>
      </div>
      <figure>
        <img src="{{ 'n98-hero.jpg' | asset_url }}" alt="Three framed N°98 map prints — Amsterdam, Venice and Copenhagen — on a dark green wall" width="1400" height="1400">
        <figcaption>AMSTERDAM · VENICE · COPENHAGEN</figcaption>
      </figure>
    </div>
  </section>

  <section class="n98-promise" aria-label="Why N°98">
    <div class="n98-wrap">
      <div><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#141414" stroke-width="1.2" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>Any place on earth</div>
      <div><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#141414" stroke-width="1.2" aria-hidden="true"><rect x="5" y="3" width="14" height="18"></rect><rect x="7.5" y="5.5" width="9" height="13"></rect></svg>White border, made to frame</div>
      <div><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#141414" stroke-width="1.2" aria-hidden="true"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 7.5V12l3 2"></path></svg>Live preview — exactly what we print</div>
      <div><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#141414" stroke-width="1.2" aria-hidden="true"><path d="M3 7h12v9H3z"></path><path d="M15 10h3.5L21 13v3h-6"></path><circle cx="7" cy="18" r="1.6"></circle><circle cx="17" cy="18" r="1.6"></circle></svg>Printed to order, sent to your door</div>
    </div>
  </section>

  <section class="n98-steps">
    <div class="n98-wrap">
      <div class="n98-sec-head n98-reveal">
        <h2>Four steps from a memory to a <em>map on the wall.</em></h2>
        <a class="n98-link-line" href="{{ n98_configurator_url }}">Start designing</a>
      </div>
      <div class="n98-step-grid">
        <div class="n98-step n98-reveal"><span class="n98-num">I</span><h3>Place</h3><p>Search any city, street or doorstep, then drag and zoom until the framing feels right.</p></div>
        <div class="n98-step n98-reveal"><span class="n98-num">II</span><h3>Style</h3><p>Choose from palettes composed to live on a wall — from midnight gold to glacier mist.</p></div>
        <div class="n98-step n98-reveal"><span class="n98-num">III</span><h3>Text</h3><p>Keep the place name or write your own: a name, a date, a line that matters.</p></div>
        <div class="n98-step n98-reveal"><span class="n98-num">IV</span><h3>Size</h3><p>Eight gallery sizes. See it hanging on a wall, to scale, before you order.</p></div>
      </div>
    </div>
  </section>

  <section class="n98-collection" id="collection">
    <div class="n98-wrap">
      <div class="n98-sec-head n98-reveal">
        <div class="n98-stack"><p class="n98-eyebrow">City editions</p><h2>Ready to hang, <em>ready to make yours.</em></h2></div>
        <a class="n98-link-line" href="{{ n98_configurator_url }}">Design any city</a>
      </div>
      <div class="n98-grid">
        <a class="n98-city n98-reveal" href="{{ n98_configurator_url }}"><div class="n98-mat"><img src="{{ 'n98-amsterdam.jpg' | asset_url }}" alt="Amsterdam map print in Electric Midnight Glow" loading="lazy" width="640" height="800"></div><div class="n98-meta"><div><span class="n98-name">Amsterdam</span><span class="n98-pal">Electric Midnight Glow</span></div><span class="n98-price">from €49</span></div></a>
        <a class="n98-city n98-reveal" href="{{ n98_configurator_url }}"><div class="n98-mat"><img src="{{ 'n98-lisbon.jpg' | asset_url }}" alt="Lisbon map print in Verdigris Dusk" loading="lazy" width="640" height="800"></div><div class="n98-meta"><div><span class="n98-name">Lisbon</span><span class="n98-pal">Verdigris Dusk</span></div><span class="n98-price">from €49</span></div></a>
        <a class="n98-city n98-reveal" href="{{ n98_configurator_url }}"><div class="n98-mat"><img src="{{ 'n98-new-york.jpg' | asset_url }}" alt="New York map print in Mint Etching" loading="lazy" width="640" height="800"></div><div class="n98-meta"><div><span class="n98-name">New York</span><span class="n98-pal">Mint Etching</span></div><span class="n98-price">from €49</span></div></a>
        <a class="n98-city n98-reveal" href="{{ n98_configurator_url }}"><div class="n98-mat"><img src="{{ 'n98-copenhagen.jpg' | asset_url }}" alt="Copenhagen map print in Bronze" loading="lazy" width="640" height="800"></div><div class="n98-meta"><div><span class="n98-name">Copenhagen</span><span class="n98-pal">Bronze</span></div><span class="n98-price">from €49</span></div></a>
        <a class="n98-city n98-reveal" href="{{ n98_configurator_url }}"><div class="n98-mat"><img src="{{ 'n98-stockholm.jpg' | asset_url }}" alt="Stockholm map print in Glacier Mist" loading="lazy" width="640" height="800"></div><div class="n98-meta"><div><span class="n98-name">Stockholm</span><span class="n98-pal">Glacier Mist</span></div><span class="n98-price">from €49</span></div></a>
