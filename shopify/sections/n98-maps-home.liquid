        <a class="n98-city n98-reveal" href="{{ n98_configurator_url }}"><div class="n98-mat"><img src="{{ 'n98-san-francisco.jpg' | asset_url }}" alt="San Francisco map print in Mono" loading="lazy" width="640" height="800"></div><div class="n98-meta"><div><span class="n98-name">San Francisco</span><span class="n98-pal">Mono</span></div><span class="n98-price">from €49</span></div></a>
