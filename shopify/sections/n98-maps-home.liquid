        <p>Place a pin on the exact spot that matters — and drag it until it's right. Every pin keeps its own symbol.</p>
        <ul>
          <li><span>i.</span>Rings for the wedding, a paw for their favourite walk</li>
          <li><span>ii.</span>A star, a tree, a heart — or simply a pin</li>
          <li><span>iii.</span>Size and colour adjustable, crisp at every print size</li>
        </ul>
      </div>
      <div class="n98-pins n98-reveal" aria-label="Pin symbols">
        <div><svg viewBox="0 0 48 48" fill="currentColor" aria-hidden="true"><path d="M24 46C17 37 11 31 11 19a13 13 0 0 1 26 0c0 12-6 18-13 27z"></path><circle cx="24" cy="19" r="5" fill="#FBFAF7"></circle></svg><b>Pin</b></div>
        <div><svg viewBox="0 0 48 48" fill="currentColor" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="3.6"><circle cx="18" cy="30" r="10"></circle><circle cx="30" cy="30" r="10"></circle></g><path d="M18 8l4 4.5-4 5-4-5z"></path></svg><b>Rings</b></div>
        <div><svg viewBox="0 0 48 48" fill="currentColor" aria-hidden="true"><path d="M24 46C17 37 11 31 11 19a13 13 0 0 1 26 0c0 12-6 18-13 27z"></path><path d="M24 40C10 30 6 24 6 17a9 9 0 0 1 18-3 9 9 0 0 1 18 3c0 7-4 13-18 23z" fill="#FBFAF7" transform="translate(24 19) scale(0.36) translate(-24 -25)"></path></svg><b>Heart pin</b></div>
        <div><svg viewBox="0 0 48 48" fill="currentColor" aria-hidden="true"><path d="M24 40C10 30 6 24 6 17a9 9 0 0 1 18-3 9 9 0 0 1 18 3c0 7-4 13-18 23z"></path></svg><b>Heart</b></div>
        <div><svg viewBox="0 0 48 48" fill="currentColor" aria-hidden="true"><ellipse cx="24" cy="34" rx="11" ry="8.5"></ellipse><ellipse cx="10" cy="21" rx="4.2" ry="5.4" transform="rotate(-20 10 21)"></ellipse><ellipse cx="18.5" cy="11.5" rx="4.4" ry="5.8" transform="rotate(-8 18.5 11.5)"></ellipse><ellipse cx="29.5" cy="11.5" rx="4.4" ry="5.8" transform="rotate(8 29.5 11.5)"></ellipse><ellipse cx="38" cy="21" rx="4.2" ry="5.4" transform="rotate(20 38 21)"></ellipse></svg><b>Paw</b></div>
        <div><svg viewBox="0 0 48 48" fill="currentColor" aria-hidden="true"><circle cx="24" cy="15" r="10"></circle><circle cx="15" cy="22" r="8"></circle><circle cx="33" cy="22" r="8"></circle><circle cx="24" cy="25" r="8"></circle><rect x="22" y="28" width="4" height="14"></rect><rect x="14" y="41" width="20" height="2.4" rx="1.2"></rect></svg><b>Tree</b></div>
        <div><svg viewBox="0 0 48 48" fill="currentColor" aria-hidden="true"><polygon points="24,4 29.9,17.6 44.5,18.6 33.4,28 37,42.4 24,34.6 11,42.4 14.6,28 3.5,18.6 18.1,17.6"></polygon></svg><b>Star</b></div>
        <div><svg viewBox="0 0 48 48" fill="currentColor" aria-hidden="true"><path d="M9 21L24 9l15 12v21H9z"></path><rect x="20.5" y="31" width="7" height="11" fill="#FBFAF7"></rect></svg><b>House</b></div>
      </div>
    </div>
  </section>

  <section class="n98-gift" id="gift">
    <div class="n98-wrap">
      <div class="n98-pair n98-reveal">
        <img src="{{ 'n98-venice.jpg' | asset_url }}" alt="Venice map print in Emerald Gold Noir" loading="lazy" width="640" height="800">
        <img src="{{ 'n98-vienna.jpg' | asset_url }}" alt="Vienna map print in Claret" loading="lazy" width="640" height="800">
