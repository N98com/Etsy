<script>
  // Zachte "fade-up" zodra blokken in beeld komen.
  (function () {
    var els = document.querySelectorAll('.n98h .n98-reveal');
    if (!('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('n98-in'); }); return; }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('n98-in'); io.unobserve(en.target); } });
    }, { rootMargin: '0px 0px -8% 0px' });
    els.forEach(function (e) { io.observe(e); });
  })();

// ---------- v2: hero, galerie, formaten, beweging ----------
(function () {
  var root = document.querySelector('.n98h');
  if (!root) return;
  var hero = root.querySelector('.n98-hero2');
  var SHOP = (hero && hero.getAttribute('data-shop-url')) || 'shop.html';
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ontwerp -> link naar de ontwerper met precies die kaart
  function designUrl(design) {
    try {
      var json = JSON.stringify(design);
      var b64 = btoa(unescape(encodeURIComponent(json))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
      return SHOP + '#design=' + b64;
    } catch (e) { return SHOP; }
  }
  function fmt(lat, lon) {
    return Math.abs(lat).toFixed(4) + '° ' + (lat >= 0 ? 'N' : 'S') + ' / ' + Math.abs(lon).toFixed(4) + '° ' + (lon >= 0 ? 'E' : 'W');
  }

  // --- hero: de lijst laadt de kaartmotor pas na de eerste weergave ---
  var frame = document.getElementById('n98h-frame');
  var iframe = document.getElementById('n98h-hero-frame');
  var coordsEl = document.getElementById('n98h-coords');
  var nowEl = document.getElementById('n98h-now');
  var form = document.getElementById('n98h-find');
  var input = document.getElementById('n98h-place');
  var status = document.getElementById('n98h-status');
  var cta = document.getElementById('n98h-cta');
  var ctaHtml = cta ? cta.innerHTML : '';
  var heroOrigin = '*';
  var tween = null;
  function countTo(lat, lon) {
    if (!coordsEl) return;
    var m = /([\d.]+)° ([NS]) \/ ([\d.]+)° ([EW])/.exec(coordsEl.textContent);
    var fromLat = m ? (+m[1]) * (m[2] === 'S' ? -1 : 1) : lat, fromLon = m ? (+m[3]) * (m[4] === 'W' ? -1 : 1) : lon;
    if (reduce) { coordsEl.textContent = fmt(lat, lon); return; }
    var t0 = performance.now(), dur = 1400;
    cancelAnimationFrame(tween);
    (function step(t) {
      var k = Math.min(1, (t - t0) / dur); k = 1 - Math.pow(1 - k, 3);
      coordsEl.textContent = fmt(fromLat + (lat - fromLat) * k, fromLon + (lon - fromLon) * k);
      if (k < 1) tween = requestAnimationFrame(step);
    })(t0);
  }
  if (iframe) {
    var src = iframe.getAttribute('data-src');
    try { heroOrigin = new URL(src, location.href).origin; } catch (e) {}
    var boot = function () { if (!iframe.src) iframe.src = src; };
    if (document.readyState === 'complete') setTimeout(boot, 300);
    else window.addEventListener('load', function () { setTimeout(boot, 300); });
  }
  window.addEventListener('message', function (e) {
    var d = e.data;
    if (!d || d.source !== 'n98-hero' || !iframe || e.source !== iframe.contentWindow) return;
    if (d.type === 'city' || d.type === 'found') {
      frame.classList.add('is-live');
      countTo(d.lat, d.lon);
      nowEl.innerHTML = (d.type === 'found' ? 'Drawn for you · ' : 'Now drawing · ') + '<b></b>';
      nowEl.querySelector('b').textContent = d.place;
    }
    if (d.type === 'searching') { status.textContent = 'Drawing ' + d.q + '…'; }
    if (d.type === 'found') {
      status.textContent = 'This is ' + d.place + (d.country ? ', ' + d.country : '') + '. Make it yours in the designer.';
      cta.href = designUrl(d.design);
      cta.innerHTML = ctaHtml.replace('Design your map', 'Continue with this map');
    }
    if (d.type === 'notfound') { status.textContent = 'We couldn’t find “' + d.q + '”. Try a city, a street or an address.'; }
  });
  if (form) form.addEventListener('submit', function (e) {
    e.preventDefault();
    var q = input.value.trim();
    if (!q) { input.focus(); return; }
    if (!iframe || !iframe.src) { window.location.href = SHOP; return; }
    status.textContent = 'Drawing ' + q + '…';
    iframe.contentWindow.postMessage({ source: 'n98-home', type: 'search', q: q }, heroOrigin);
    if (window.innerWidth < 900) frame.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
  });

  // --- galerie: elke print opent in de ontwerper, loep bij hover ---
  var designs = {};
  try { designs = JSON.parse((document.getElementById('n98h-designs') || {}).textContent || '{}'); } catch (e) {}
  root.querySelectorAll('[data-design]').forEach(function (a) {
    var d = designs[a.getAttribute('data-design')];
    if (d) a.href = designUrl(d);
  });
  root.querySelectorAll('.n98-salon .n98-pimg').forEach(function (box) {
    var img = box.querySelector('img'), lens = box.querySelector('.n98-loupe');
    if (!img || !lens) return;
    var ZOOM = 3;
    box.addEventListener('pointermove', function (e) {
      if (e.pointerType === 'touch') return;
      var r = box.getBoundingClientRect(), x = e.clientX - r.left, y = e.clientY - r.top;
      var lw = lens.offsetWidth / 2;
      lens.style.left = (x - lw) + 'px'; lens.style.top = (y - lw) + 'px';
      lens.style.backgroundImage = 'url("' + (img.currentSrc || img.src) + '")';
      lens.style.backgroundSize = (r.width * ZOOM) + 'px ' + (r.height * ZOOM) + 'px';
      lens.style.backgroundPosition = (lw - x * ZOOM) + 'px ' + (lw - y * ZOOM) + 'px';
    });
  });

  // --- zachte diepte: prints schuiven heel licht mee met scrollen ---
  var depthEls = [].slice.call(root.querySelectorAll('[data-depth]'));
  var macro = root.querySelector('.n98-macro');
  if (!reduce && depthEls.length && window.innerWidth >= 900) {
    var ticking = false;
    var onScroll = function () {
      if (ticking) return; ticking = true;
      requestAnimationFrame(function () {
        ticking = false;
        var vh = window.innerHeight;
        depthEls.forEach(function (el) {
          var r = el.getBoundingClientRect();
          if (r.bottom < -200 || r.top > vh + 200) return;
          var off = (r.top + r.height / 2 - vh / 2) * parseFloat(el.getAttribute('data-depth'));
          el.style.transform = 'translate3d(0,' + off.toFixed(1) + 'px,0)';
        });
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  // --- formaten op schaal ---
  var room = document.getElementById('n98h-room'), tag = document.getElementById('n98h-room-tag');
  var sizes = document.getElementById('n98h-sizes');
  if (room && sizes) sizes.addEventListener('click', function (e) {
    var b = e.target.closest('button[data-w]');
    if (!b) return;
    sizes.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
    room.style.setProperty('--w', b.getAttribute('data-w'));
    room.style.setProperty('--h', b.getAttribute('data-h'));
    tag.textContent = b.getAttribute('data-w') + '×' + b.getAttribute('data-h') + ' cm above a 220 cm sofa';
  });
})();

// ---------- v3: het potlood tekent de kaart ----------
// De lijnen komen uit tools/home-renders (de echte kaartmotor heeft elke straat
// opgeschreven). Hier tekent een potlood ze na, versneld: eerst de grote wegen
// één voor één, daarna arceert hij de kleine straatjes vak voor vak. Dan komen
// water en parken erbij en gaat het over in de afgedrukte poster met tekst.
(function () {
  var frame = document.getElementById('n98h-frame');
  var stage = document.getElementById('n98h-draw');
  var finalImg = document.getElementById('n98h-final');
  var pencil = document.getElementById('n98h-pencil');
  if (!frame || !stage || !finalImg || !pencil) return;
  var root = document.querySelector('.n98h');
  // meerdere adressen: als het eerste (nog) niet werkt, probeert hij het volgende
  var TRACE_BASES = (frame.getAttribute('data-trace-base') || 'img/home/').split(/\s+/).filter(Boolean);
  var cities = [].slice.call(document.querySelectorAll('#n98h-cities img')).map(function (im) {
    return { id: im.getAttribute('data-id'), place: im.getAttribute('data-place'), lat: +im.getAttribute('data-lat'), lon: +im.getAttribute('data-lon'), img: im };
  });
  if (!cities.length) return;
  // data-pencil="off": geen potlood in beeld, de lijnen verschijnen vanzelf en rustiger
  var NO_PENCIL = frame.getAttribute('data-pencil') === 'off';
  if (NO_PENCIL) pencil.style.display = 'none';
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var nowEl = document.getElementById('n98h-now');
  var coordsEl = document.getElementById('n98h-coords');
  var traces = {};
  var ctx = stage.getContext('2d');
  var lineCv = document.createElement('canvas'), lctx = lineCv.getContext('2d');
  var areaCv = document.createElement('canvas'), actx = areaCv.getContext('2d');
  var W = 0, H = 0, raf = 0, idx = 0, visible = true;

  function fmt(lat, lon) { return Math.abs(lat).toFixed(4) + '° ' + (lat >= 0 ? 'N' : 'S') + ' / ' + Math.abs(lon).toFixed(4) + '° ' + (lon >= 0 ? 'E' : 'W'); }
  function countTo(lat, lon) {
    if (!coordsEl) return;
    var m = /([\d.]+)° ([NS]) \/ ([\d.]+)° ([EW])/.exec(coordsEl.textContent);
    var a = m ? (+m[1]) * (m[2] === 'S' ? -1 : 1) : lat, b = m ? (+m[3]) * (m[4] === 'W' ? -1 : 1) : lon, t0 = performance.now();
    (function step(t) { var k = Math.min(1, (t - t0) / 1400); k = 1 - Math.pow(1 - k, 3); coordsEl.textContent = fmt(a + (lat - a) * k, b + (lon - b) * k); if (k < 1) requestAnimationFrame(step); })(t0);
  }
  function label(c) {
    if (!nowEl) return;
    nowEl.innerHTML = 'Now drawing · <b></b>'; nowEl.querySelector('b').textContent = c.place;
    countTo(c.lat, c.lon);
  }
  function load(c) {
    if (traces[c.id]) return Promise.resolve(traces[c.id]);
    var i = 0;
    function attempt() {
      return fetch(TRACE_BASES[i] + c.id + '.trace.json').then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
        .catch(function (e) { if (++i < TRACE_BASES.length) return attempt(); throw e; });
    }
    return attempt().then(function (t) { if (!t || !t.lines || !t.lines.length) throw new Error('empty'); traces[c.id] = prepare(t); return traces[c.id]; });
  }

  // lijnen klaarzetten: grote wegen (op volgorde van een reizend potlood) en
  // kleine straatjes per vak van het raster (heen en weer, zoals arceren)
  function prepare(t) {
    var q = t.q || 1;
    var lines = t.lines.map(function (l) {
      var f = l[1], pts = [], len = 0, seg = [0];
      for (var i = 0; i < f.length; i += 2) {
        var x = f[i] / q, y = f[i + 1] / q;
        if (pts.length) { var p = pts[pts.length - 1]; len += Math.hypot(x - p[0], y - p[1]); seg.push(len); }
        pts.push([x, y]);
      }
      var st = t.styles[l[0]];
      return { c: st[0], w: st[1], a: st[2], pts: pts, len: len, seg: seg };
    });
    var widths = lines.map(function (l) { return l.w; }).sort(function (a, b) { return b - a; });
    var cut = widths[Math.min(widths.length - 1, Math.floor(widths.length * 0.12))];
    var majors = lines.filter(function (l) { return l.w >= cut && l.w > 0; }).sort(function (a, b) { return b.len - a.len; }).slice(0, 420);
    var majorSet = new Set(majors);
    // potlood reist steeds naar de dichtstbijzijnde volgende weg
    var order = [], left = majors.slice(), cur = [t.w / 2, t.h / 2];
    while (left.length) {
      var bi = 0, bd = Infinity, flip = false;
      for (var i = 0; i < left.length; i++) {
        var a = left[i].pts[0], b = left[i].pts[left[i].pts.length - 1];
        var da = (a[0] - cur[0]) * (a[0] - cur[0]) + (a[1] - cur[1]) * (a[1] - cur[1]);
        var db = (b[0] - cur[0]) * (b[0] - cur[0]) + (b[1] - cur[1]) * (b[1] - cur[1]);
        if (da < bd) { bd = da; bi = i; flip = false; }
        if (db < bd) { bd = db; bi = i; flip = true; }
      }
      var L = left.splice(bi, 1)[0];
      if (flip) { L.pts = L.pts.slice().reverse(); var s = [0], acc = 0; for (var k = 1; k < L.pts.length; k++) { acc += Math.hypot(L.pts[k][0] - L.pts[k - 1][0], L.pts[k][1] - L.pts[k - 1][1]); s.push(acc); } L.seg = s; }
      order.push(L); cur = L.pts[L.pts.length - 1];
    }
    var CELL = Math.max(t.w, t.h) / 9, cols = Math.ceil(t.w / CELL), rows = Math.ceil(t.h / CELL), cells = [];
    for (var r = 0; r < rows; r++) for (var cc = 0; cc < cols; cc++) cells.push({ x: (r % 2 ? cols - 1 - cc : cc), y: r, lines: [] });
    var byKey = {}; cells.forEach(function (ce) { byKey[ce.x + ',' + ce.y] = ce; });
    lines.forEach(function (l) {
      if (majorSet.has(l)) return;
      var m = l.pts[Math.floor(l.pts.length / 2)];
      var ce = byKey[Math.min(cols - 1, Math.max(0, Math.floor(m[0] / CELL))) + ',' + Math.min(rows - 1, Math.max(0, Math.floor(m[1] / CELL)))];
      if (ce) ce.lines.push(l);
    });
    cells.forEach(function (ce) { ce.cx = (ce.x + 0.5) * CELL; ce.cy = (ce.y + 0.5) * CELL; });
    // zonder potlood: de kleine straatjes als een golf van het midden naar buiten
    var cx = t.w / 2, cy = t.h * 0.46;
    var wave = lines.filter(function (l) { return !majorSet.has(l); }).map(function (l) {
      var m = l.pts[Math.floor(l.pts.length / 2)];
      return { l: l, d: Math.hypot(m[0] - cx, m[1] - cy) + Math.random() * t.w * 0.06 };
    }).sort(function (a, b) { return a.d - b.d; }).map(function (x) { return x.l; });
    return { t: t, majors: order, cells: cells.filter(function (ce) { return ce.lines.length; }), wave: wave };
  }

  function size() {
    var r = stage.getBoundingClientRect(), d = Math.min(2, window.devicePixelRatio || 1);
    W = stage.width = lineCv.width = areaCv.width = Math.round(r.width * d);
    H = stage.height = lineCv.height = areaCv.height = Math.round(r.height * d);
  }
  function strokeLine(c2, l, k, until) {
    // grafiet: hoe dikker de weg, hoe donkerder en steviger de lijn
    c2.globalAlpha = Math.min(0.92, 0.42 + l.w * 0.12) * l.a; c2.strokeStyle = '#2B2A27'; c2.lineWidth = Math.max(0.55, Math.min(3.2, l.w * 0.8) * k); c2.lineCap = 'round'; c2.lineJoin = 'round';
    c2.beginPath(); c2.moveTo(l.pts[0][0] * k, l.pts[0][1] * k);
    var tip = l.pts[0];
    for (var i = 1; i < l.pts.length; i++) {
      if (until != null && l.seg[i] > until) {
        var f = (until - l.seg[i - 1]) / ((l.seg[i] - l.seg[i - 1]) || 1);
        tip = [l.pts[i - 1][0] + (l.pts[i][0] - l.pts[i - 1][0]) * f, l.pts[i - 1][1] + (l.pts[i][1] - l.pts[i - 1][1]) * f];
        c2.lineTo(tip[0] * k, tip[1] * k); break;
      }
      tip = l.pts[i]; c2.lineTo(tip[0] * k, tip[1] * k);
    }
    c2.stroke(); c2.globalAlpha = 1;
    return tip;
  }
  // potlood: punt precies op de lijn, met een klein beetje beweging in de hand
  var pAngle = -38;
  function pencilAt(x, y, dx, dy, lift) {
    var r = stage.getBoundingClientRect(), fr = frame.getBoundingClientRect();
    var px = r.left - fr.left + x / W * r.width, py = r.top - fr.top + y / H * r.height;
    if (dx || dy) { var want = -38 + Math.max(-9, Math.min(9, Math.atan2(dy, dx) * 180 / Math.PI / 12)); pAngle += (want - pAngle) * 0.15; }
    pencil.style.transform = 'translate3d(' + px.toFixed(1) + 'px,' + (py - (lift || 0)).toFixed(1) + 'px,0) rotate(' + pAngle.toFixed(1) + 'deg)';
  }

  function play(c, tr) {
    cancelAnimationFrame(raf);
    size();
    var t = tr.t, k = W / t.w;
    lctx.clearRect(0, 0, W, H);
    actx.clearRect(0, 0, W, H);
    t.areas.forEach(function (ar) {
      actx.fillStyle = ar[0]; actx.beginPath();
      ar[1].forEach(function (ring) { for (var i = 0; i < ring.length; i += 2) { var x = ring[i] / t.q * k, y = ring[i + 1] / t.q * k; if (i) actx.lineTo(x, y); else actx.moveTo(x, y); } actx.closePath(); });
      actx.fill('evenodd');
    });
    label(c);
    frame.classList.remove('is-final');
    frame.classList.add('is-drawing');
    var SPEED = 1500 / 1000 * (t.w / 1200);      // grote wegen: px per ms in kaartmaat
    var majorTotal = tr.majors.reduce(function (s, l) { return s + l.len; }, 0);
    var MAJOR_MS = NO_PENCIL ? Math.min(12000, Math.max(9000, majorTotal / SPEED * 1.8)) : Math.min(8500, Math.max(4200, majorTotal / SPEED));
    var WAVE_MS = 14000, wi = 0;
    var CELL_MS = 5600 / Math.max(1, tr.cells.length);
    var mi = 0, mDone = 0, ci = 0, cellT = 0, phase = 'major', last = performance.now(), areaA = 0, t0 = last;
    var speed = majorTotal / MAJOR_MS;
    function frameStep(now) {
      var dt = Math.min(50, now - last); last = now;
      if (!visible) { raf = requestAnimationFrame(frameStep); return; }
      if (phase === 'major') {
        var budget = speed * dt, tip = null, prev = null;
        while (budget > 0 && mi < tr.majors.length) {
          var L = tr.majors[mi], rest = L.len - mDone;
          if (budget >= rest) { strokeLine(lctx, L, k); budget -= rest; mi++; mDone = 0; tip = L.pts[L.pts.length - 1]; prev = L.pts[Math.max(0, L.pts.length - 2)]; }
          else { mDone += budget; budget = 0; tip = strokeLine(lctx, L, k, mDone); var si = 1; while (si < L.seg.length - 1 && L.seg[si] < mDone) si++; prev = L.pts[si - 1]; }
        }
        if (tip && !NO_PENCIL) pencilAt(tip[0] * k, tip[1] * k, tip[0] - prev[0], tip[1] - prev[1]);
        if (mi >= tr.majors.length) { phase = 'minor'; lctx.globalCompositeOperation = 'destination-over'; }
      } else if (phase === 'minor' && NO_PENCIL) {
        cellT += dt;
        var f = Math.min(1, cellT / WAVE_MS); f = f < 0.5 ? 2 * f * f : 1 - Math.pow(-2 * f + 2, 2) / 2;
        var upto = Math.floor(tr.wave.length * f);
        while (wi < upto) strokeLine(lctx, tr.wave[wi++], k);
        if (wi >= tr.wave.length) { phase = 'wash'; lctx.globalCompositeOperation = 'source-over'; t0 = now; }
      } else if (phase === 'minor') {
        cellT += dt;
        while (cellT >= CELL_MS && ci < tr.cells.length) {
          tr.cells[ci].lines.forEach(function (l) { strokeLine(lctx, l, k); });
          ci++; cellT -= CELL_MS;
        }
        if (ci < tr.cells.length) {
          var ce = tr.cells[ci], f = cellT / CELL_MS, wob = Math.sin(now / 38) * 14 * k * (t.w / 1200);
          var prevC = tr.cells[Math.max(0, ci - 1)];
          pencilAt((prevC.cx + (ce.cx - prevC.cx) * f) * k + wob, (prevC.cy + (ce.cy - prevC.cy) * f) * k + Math.cos(now / 51) * 10 * k, ce.cx - prevC.cx, ce.cy - prevC.cy);
        } else { phase = 'wash'; lctx.globalCompositeOperation = 'source-over'; t0 = now; frame.classList.add('is-lifting'); }
      } else if (phase === 'wash') {
        areaA = Math.min(1, (now - t0) / (NO_PENCIL ? 1600 : 1200));
        if (areaA >= 1) { phase = 'done'; }
      }
      ctx.clearRect(0, 0, W, H);
      ctx.fillStyle = t.bg || '#F4F1EB'; ctx.fillRect(0, 0, W, H);
      if (areaA > 0) { ctx.globalAlpha = areaA; ctx.drawImage(areaCv, 0, 0); ctx.globalAlpha = 1; }
      ctx.drawImage(lineCv, 0, 0);
      if (phase !== 'done') { raf = requestAnimationFrame(frameStep); return; }
      // over naar de echte poster met tekst
      finalImg.src = c.img.currentSrc || c.img.src;
      var show = function () { frame.classList.add('is-final'); frame.classList.remove('is-drawing', 'is-lifting'); setTimeout(next, NO_PENCIL ? 6500 : 5200); };
      if (finalImg.complete && finalImg.naturalWidth) setTimeout(show, 60); else finalImg.onload = show;
    }
    raf = requestAnimationFrame(frameStep);
  }
  function next() {
    idx = (idx + 1) % cities.length;
    start(cities[idx]);
  }
  function start(c) {
    load(c).then(function (tr) { play(c, tr); }).catch(function () { finalImg.src = c.img.src; frame.classList.add('is-final'); setTimeout(next, 6000); });
    var n = cities[(cities.indexOf(c) + 1) % cities.length];
    load(n).catch(function () {});
    if (n.img.loading === 'lazy') n.img.loading = 'eager';
  }
  if (reduce) { frame.classList.add('is-final'); return; }
  if ('IntersectionObserver' in window) new IntersectionObserver(function (es) { visible = es[0].isIntersecting; }).observe(frame);
  window.addEventListener('resize', function () { /* volgende stad pakt de nieuwe maat */ });
  var boot = function () { start(cities[0]); };
  if (document.readyState === 'complete') setTimeout(boot, 250); else window.addEventListener('load', function () { setTimeout(boot, 250); });
})();
</script>
</div>

