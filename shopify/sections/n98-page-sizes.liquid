  <section class="n98p-hero">
    <div class="n98-wrap">
      <p class="n98-eyebrow">Sizes &amp; frames</p>
      <h1>Every size, <em>every frame.</em></h1>
      <p class="n98p-lede">Eight gallery sizes, from a bedside shelf to a statement wall. Each one is printed on premium matte paper and can arrive unframed or in a solid wood frame, ready to hang. Shipping is free, everywhere.</p>
    </div>
  </section>

  <section class="n98p-sec" id="sizes">
    <div class="n98-wrap">
      <p class="n98-eyebrow">Sizes and prices</p>
      <h2>Choose the size, <em>we do the rest.</em></h2>
      <table class="n98p-table">
        <thead><tr><th>Size</th><th>Inches</th><th>Unframed</th><th>Framed</th></tr></thead>
        <tbody>
          {%- for row in n98_sizes -%}
            {%- assign f = row | split: '|' -%}
            {%- assign framed_sku = f[0] | append: '-black' -%}
            {%- assign p_plain = nil -%}{%- assign p_framed = nil -%}
            {%- if n98_product -%}
              {%- for v in n98_product.variants -%}
                {%- if v.sku == f[0] -%}{%- assign p_plain = v.price -%}{%- endif -%}
                {%- if v.sku == framed_sku -%}{%- assign p_framed = v.price -%}{%- endif -%}
              {%- endfor -%}
            {%- endif -%}
            {%- assign iw = f[3] | divided_by: 2 -%}{%- assign ih = f[4] | divided_by: 2 -%}
            <tr>
              <td><div class="n98p-size"><i style="--w:{{ iw }}px;--h:{{ ih }}px"></i><div><b>{{ f[1] }}</b></div></div></td>
              <td class="n98p-in">{{ f[2] }}</td>
              <td class="n98p-price">{% if p_plain %}{{ p_plain | money }}{% endif %}</td>
              <td class="n98p-price">{% if p_framed %}{{ p_framed | money }}{% endif %}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
      <p class="n98p-note">All prices include VAT and free shipping within Europe, the UK and the US. Framed prices are the same for every frame colour.</p>
    </div>
  </section>

  <section class="n98p-sec" id="frames">
    <div class="n98-wrap">
      <p class="n98-eyebrow">Frames</p>
      <h2>Solid wood, <em>ready to hang.</em></h2>
      <div class="n98p-frames">
        <div class="n98p-frame"><div class="n98p-swatch"><span style="outline:14px solid #1E1D1B;--map:url('{{ 'n98-frame-black.jpg' | asset_url }}')"></span></div><h3>Black</h3><p>Deep and graphic. Lets light palettes glow.</p></div>
        <div class="n98p-frame"><div class="n98p-swatch"><span style="outline:14px solid #F4F2EE;--map:url('{{ 'n98-frame-white.jpg' | asset_url }}');box-shadow:inset 0 2px 5px rgba(0,0,0,.2),0 0 0 15px #D9D3C8,0 18px 30px -18px rgba(20,20,20,.45)"></span></div><h3>White</h3><p>Quiet and gallery like, for bright rooms.</p></div>
        <div class="n98p-frame"><div class="n98p-swatch"><span style="outline:14px solid #C9A87C;--map:url('{{ 'n98-frame-natural.jpg' | asset_url }}')"></span></div><h3>Natural wood</h3><p>Warm and light, at home in Scandinavian interiors.</p></div>
        <div class="n98p-frame"><div class="n98p-swatch"><span style="outline:14px solid #5B3F2C;--map:url('{{ 'n98-frame-darkwood.jpg' | asset_url }}')"></span></div><h3>Dark wood</h3><p>Rich and classic, made for darker palettes.</p></div>
        <div class="n98p-frame"><div class="n98p-swatch"><span style="--map:url('{{ 'n98-frame-none.jpg' | asset_url }}');box-shadow:0 18px 30px -18px rgba(20,20,20,.45),0 2px 4px rgba(20,20,20,.12)"></span></div><h3>No frame</h3><p>Every size fits a standard ready made frame, so you can use your own.</p></div>
      </div>
      <div class="n98p-specs" style="margin-top:48px">
        <div class="n98p-spec"><span class="n98-eyebrow">Frame</span><p>Solid pine</p><small>2 to 2.5 cm deep, 1 to 1.4 cm wide. Light, sturdy and made to last.</small></div>
        <div class="n98p-spec"><span class="n98-eyebrow">Glazing</span><p>Shatterproof plexiglass</p><small>Crystal clear and far lighter than glass, so it is safe in the post and on any wall.</small></div>
        <div class="n98p-spec"><span class="n98-eyebrow">Hanging</span><p>Ready to hang</p><small>Hanging kit included for portrait or landscape. From 60×90 the hook comes fixed to the back.</small></div>
        <div class="n98p-spec"><span class="n98-eyebrow">Value</span><p>No framer needed</p><small>One price for print, frame and delivery, often less than custom framing alone.</small></div>
      </div>
    </div>
  </section>

  <section class="n98p-sec" id="paper">
    <div class="n98-wrap">
      <p class="n98-eyebrow">Paper &amp; print</p>
      <h2>Printed to last, <em>made to order.</em></h2>
      <div class="n98p-specs">
        <div class="n98p-spec"><span class="n98-eyebrow">Paper</span><p>Premium matte, 200 gsm</p><small>80 lb, 0.22 mm. Smooth and non reflective, so every street reads crisply.</small></div>
        <div class="n98p-spec"><span class="n98-eyebrow">Sourcing</span><p>FSC certified paper</p><small>Or an equivalent certification, depending on the print studio.</small></div>
        <div class="n98p-spec"><span class="n98-eyebrow">Production</span><p>Printed close to you</p><small>Every map is printed fresh after you order, at a studio near the delivery address.</small></div>
        <div class="n98p-spec"><span class="n98-eyebrow">Delivery</span><p>Free, always</p><small>To Europe, the UK and the US. Usually 3 to 7 working days in Europe, 5 to 10 in the US.</small></div>
      </div>
    </div>
  </section>

  <section class="n98p-cta">
    <div class="n98-wrap">
      <p class="n98-eyebrow">N°98 Maps</p>
      <h2>Found your size? <em>Find your place.</em></h2>
      <a class="n98-btn" href="{{ n98_url }}">Design your map <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4" stroke="currentColor" stroke-width="1.2"/></svg></a>
    </div>
  </section>
</div>
{%- endcase -%}

{% schema %}
{
  "name": "N°98 sizes & frames",
  "settings": [
    { "type": "text", "id": "configurator_handle", "label": "Configurator product handle", "default": "design-your-map" }
  ]
}
{% endschema %}
