{% schema %}
{
  "name": "N°98 social",
  "settings": [
    { "type": "text", "id": "whatsapp", "label": "WhatsApp number (international, digits only)", "default": "31613168888" },
    { "type": "url", "id": "instagram", "label": "Instagram link" },
    { "type": "url", "id": "pinterest", "label": "Pinterest link", "info": "Leave empty until the account exists: the icon stays visible without a link." },
    { "type": "url", "id": "facebook", "label": "Facebook link", "info": "Leave empty until the page exists: the icon stays visible without a link." }
  ],
  "enabled_on": { "groups": ["footer"] },
  "presets": [{ "name": "N°98 social" }]
}
{% endschema %}
