{%- comment -%}
  N°98 Maps: social icons at the top of the footer.
  Links are editable in the theme editor (Footer, "N°98 social").
{%- endcomment -%}
{%- case request.locale.iso_code -%}
{%- when 'de' -%}
<div class="n98-footsocial">
  <p class="n98-footsocial__label">Sag hallo</p>
  {% render 'n98-social-icons',
    whatsapp: section.settings.whatsapp,
    instagram: section.settings.instagram,
    pinterest: section.settings.pinterest,
    facebook: section.settings.facebook
  %}
</div>
<style>
  .n98-footsocial { display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 44px 20px 30px; background: #F4F1EB; border-top: 1px solid #DDD6CA; }
  .n98-footsocial__label { margin: 0; font-family: 'IBM Plex Mono', ui-monospace, Menlo, monospace; font-size: 10px; letter-spacing: .3em; text-transform: uppercase; color: #5E594F; }
  .n98-social { display: flex; gap: 14px; margin: 0; padding: 0; list-style: none; }
  .n98-social li { margin: 0; }
  .n98-social a, .n98-social span { display: grid; place-items: center; width: 46px; height: 46px; border: 1px solid #DDD6CA; border-radius: 50%; color: #141414; transition: background .3s ease, color .3s ease, border-color .3s ease; }
  .n98-social a:hover, .n98-social a:focus-visible { background: #141414; border-color: #141414; color: #F4F1EB; }
  .n98-social span { cursor: default; }
</style>
